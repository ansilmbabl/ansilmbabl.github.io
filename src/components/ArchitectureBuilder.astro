</style>

<script define:vars={{ lessons, componentCatalog }}>
  const lessonData = lessons;
  const components = Object.fromEntries(componentCatalog.map((item) => [item.id, item]));
  const colors = { boundary: '#7d4f73', core: '#176b58', generation: '#176b58', action: '#8a633a', knowledge: '#47765b', data: '#47765b', safety: '#a66d3b', performance: '#637747', quality: '#4d687f', operations: '#4d687f', security: '#a66d3b', runtime: '#637747' };
  let activeIndex = 0;
  let diagramZoom = 1;
  let didFitDiagram = false;
  const nodes = document.querySelector('[data-lesson-nodes]');
  const edges = document.querySelector('[data-lesson-edges]');
  const stage = document.querySelector('.lesson-stage');
  const canvas = document.querySelector('[data-lesson-canvas]');
  const viewport = document.querySelector('[data-lesson-viewport]');
  const zoomLevel = document.querySelector('[data-zoom-level]');
  const diagramPanel = document.querySelector('[data-lesson-diagram]');
  const selectedNote = document.querySelector('[data-selected-note]');
  const scenarioBrief = document.querySelector('[data-scenario-brief]');
    const lessonLegend = document.querySelector('[data-lesson-legend]');
  const canonicalIds = { input: 'visitor', visitor: 'visitor', request: 'visitor', entry: 'visitor', output: 'response', response: 'response', answer: 'response', result: 'response', system: 'ai-assistant', 'ai-system': 'ai-assistant', assistant: 'ai-assistant', agent: 'orchestrator', vector: 'vector-store', 'vector-db': 'vector-store', tools: 'tools', tool: 'tools' };
  const canonicalId = (id) => canonicalIds[id] ?? id;
  const isDiagramMarker = (node) => ['container', 'container-wide', 'boundary-container'].includes(node.kind);
  const getCumulativeGraph = (index) => {
    const graphNodes = [];
    const byId = new Map();
    const graphConnections = [];
    const connectionKeys = new Set();
    lessonData.slice(1, index + 1).forEach((item) => {
      item.replaces.forEach((rawId) => {
        const id = canonicalId(rawId);
        byId.delete(id);
        const nodeIndex = graphNodes.findIndex((node) => node.id === id);
        if (nodeIndex >= 0) graphNodes.splice(nodeIndex, 1);
        for (let i = graphConnections.length - 1; i >= 0; i -= 1) {
          if (graphConnections[i].from === id || graphConnections[i].to === id) graphConnections.splice(i, 1);
        }
        [...connectionKeys].forEach((key) => { if (key.startsWith(`${id}|`) || key.includes(`|${id}|`)) connectionKeys.delete(key); });
      });
      item.removesConnections.forEach((connection) => {
        const from = canonicalId(connection.from);
        const to = canonicalId(connection.to);
        for (let i = graphConnections.length - 1; i >= 0; i -= 1) {
          if (graphConnections[i].from === from && graphConnections[i].to === to) graphConnections.splice(i, 1);
        }
        [...connectionKeys].forEach((key) => { if (key.startsWith(`${from}|${to}|`)) connectionKeys.delete(key); });
      });
      item.nodes.filter((node) => !isDiagramMarker(node)).forEach((node) => {
        const id = canonicalId(node.id);
        const next = { ...node, id };
        const existing = byId.get(id);
        if (!existing) {
          byId.set(id, next);
          graphNodes.push(next);
        } else {
          Object.assign(existing, next);
        }
      });
      item.connections.forEach((connection) => {
        const from = canonicalId(connection.from);
        const to = canonicalId(connection.to);
        const key = `${from}|${to}|${connection.label ?? ''}`;
        if (byId.has(from) && byId.has(to) && !connectionKeys.has(key)) {
          connectionKeys.add(key);
          graphConnections.push({ ...connection, from, to });
        }
      });
    });
    const placed = [];
    graphNodes.forEach((node) => {
      let x = node.x;
      let y = node.y;
      while (placed.some((other) => Math.abs(other.x - x) < 10 && Math.abs(other.y - y) < 16)) {
        y += 15;
        if (y > 88) { y = 14; x += 12; }
      }
      node.x = Math.min(x, 92);
      node.y = Math.min(y, 88);
      placed.push({ x: node.x, y: node.y });
    });
    return { nodes: graphNodes, connections: graphConnections };
  };
  const getCompoundGraph = (index) => {
    const graph = getCumulativeGraph(index);
    if (index < 9) return graph;
    const active = new Set(lessonData[index].highlight.map(canonicalId));
    const collapsed = new Set(['orchestrator', 'fast-model', 'reasoning-model', 'prompt', 'model', 'rag', 'retriever', 'reranker', 'sources', 'pipeline', 'embeddings', 'index', 'vector-store', 'tools', 'guard', 'cache', 'evaluation']);
    const visibleNodes = graph.nodes.filter((node) => !collapsed.has(node.id) || active.has(node.id) || node.id === 'ai-assistant');
    const visibleIds = new Set(visibleNodes.map((node) => node.id));
    const edgeKeys = new Set();
    const visibleConnections = [];
    graph.connections.forEach((connection) => {
      const from = collapsed.has(connection.from) && !active.has(connection.from) ? 'ai-assistant' : connection.from;
      const to = collapsed.has(connection.to) && !active.has(connection.to) ? 'ai-assistant' : connection.to;
      if (from === to || !visibleIds.has(from) || !visibleIds.has(to)) return;
      const key = `${from}|${to}|${connection.label ?? ''}`;
      if (!edgeKeys.has(key)) { edgeKeys.add(key); visibleConnections.push({ ...connection, from, to }); }
    });
    return { nodes: visibleNodes, connections: visibleConnections };
  };

  const setSelected = (node, item) => {
    document.querySelector('[data-compound-inspector]').hidden = true;
    document.querySelectorAll('.lesson-node').forEach((element) => element.classList.toggle('active', element.dataset.nodeId === node.id));
    const source = components[node.id];
    document.querySelector('[data-selected-title]').textContent = node.label;
    document.querySelector('[data-selected-copy]').textContent = source?.description ?? node.detail;
    document.querySelector('[data-selected-role]').textContent = source?.solves ?? node.detail;
    document.querySelector('[data-selected-risk]').textContent = source?.risks ?? item.without;
    document.querySelector('[data-selected-tradeoff]').textContent = source?.tradeoff ?? item.tradeoff;
  };

  const openCompound = (node, item) => {
    const inspector = document.querySelector('[data-compound-inspector]');
    const title = document.querySelector('[data-compound-title]');
    const copy = document.querySelector('[data-compound-copy]');
    const tiles = document.querySelector('[data-compound-tiles]');
    title.textContent = node.label;
    copy.textContent = `${node.label} combines ${node.merge?.length ?? 0} components from the earlier stages.`;
    tiles.replaceChildren(...(node.merge ?? []).map((id) => {
      const source = components[id] ?? lessonData.flatMap((entry) => entry.nodes).find((entry) => canonicalId(entry.id) === canonicalId(id));
      const tile = document.createElement('div');
      tile.className = 'compound-tile-detail';
      tile.style.setProperty('--tile-color', colors[source?.category ?? source?.kind] ?? '#176b58');
      tile.innerHTML = `<b>${source?.title ?? source?.label ?? id}</b><small>${source?.description ?? source?.detail ?? 'A component carried into this system boundary.'}</small>`;
      return tile;
    }));
    inspector.hidden = false;
    inspector.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  };

  const drawEdges = (lesson, connections = lesson.connections) => {
    edges.querySelectorAll('.dynamic-lesson-edge').forEach((edge) => edge.remove());
    const stageRect = stage.getBoundingClientRect();
    const scale = stageRect.width / 1400;
    connections.forEach((connection) => {
      const from = document.querySelector(`[data-node-id="${connection.from}"]`);
      const to = document.querySelector(`[data-node-id="${connection.to}"]`);
      if (!from || !to) return;
      const fromRect = from.getBoundingClientRect();
      const toRect = to.getBoundingClientRect();
      const local = (value) => value / scale;
      const fromCenter = { x: local(fromRect.left - stageRect.left + fromRect.width / 2), y: local(fromRect.top - stageRect.top + fromRect.height / 2) };
      const toCenter = { x: local(toRect.left - stageRect.left + toRect.width / 2), y: local(toRect.top - stageRect.top + toRect.height / 2) };
      const horizontal = Math.abs(toCenter.x - fromCenter.x) >= Math.abs(toCenter.y - fromCenter.y);
      let sx; let sy; let tx; let ty; let pathData; let labelX; let labelY;
      if (horizontal) {
        const forward = toCenter.x >= fromCenter.x;
        sx = local((forward ? fromRect.right : fromRect.left) - stageRect.left); sy = fromCenter.y;
        tx = local((forward ? toRect.left : toRect.right) - stageRect.left); ty = toCenter.y;
        const midX = sx + (tx - sx) / 2;
        pathData = `M ${sx} ${sy} H ${midX} V ${ty} H ${tx}`;
        labelX = midX + 6; labelY = (sy + ty) / 2 - 7;
      } else {
        const downward = toCenter.y >= fromCenter.y;
        sx = fromCenter.x; sy = local((downward ? fromRect.bottom : fromRect.top) - stageRect.top);
        tx = toCenter.x; ty = local((downward ? toRect.top : toRect.bottom) - stageRect.top);
        const midY = sy + (ty - sy) / 2;
        pathData = `M ${sx} ${sy} V ${midY} H ${tx} V ${ty}`;
        labelX = (sx + tx) / 2 + 6; labelY = midY - 7;
      }
      const group = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      group.classList.add('dynamic-lesson-edge');
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', pathData); path.setAttribute('class', 'lesson-edge'); group.append(path);
      [[sx, sy], [tx, ty]].forEach(([x, y]) => {
        const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
        dot.setAttribute('cx', String(x)); dot.setAttribute('cy', String(y)); dot.setAttribute('r', '4'); dot.setAttribute('class', 'lesson-edge-dot'); group.append(dot);
      });
      if (connection.label) {
        const label = document.createElementNS('http://www.w3.org/2000/svg', 'text');
        label.textContent = connection.label; label.setAttribute('x', String(labelX)); label.setAttribute('y', String(labelY)); label.setAttribute('class', 'lesson-edge-label'); group.append(label);
      }
      edges.append(group);
    });
  };

  const setZoom = (value) => {
    diagramZoom = Math.max(0.45, Math.min(1.5, value));
    stage.style.transform = `scale(${diagramZoom})`;
    canvas.style.width = `${1400 * diagramZoom}px`;
    canvas.style.height = `${820 * diagramZoom}px`;
    zoomLevel.textContent = `${Math.round(diagramZoom * 100)}%`;
    requestAnimationFrame(() => drawEdges(lessonData[activeIndex], getCompoundGraph(activeIndex).connections));
  };
  const fitZoom = () => {
    const widthFit = (viewport.clientWidth - 12) / 1400;
    const heightFit = (viewport.clientHeight - 12) / 820;
    setZoom(Math.min(1, widthFit, heightFit));
  };

  const renderLesson = (index) => {
    activeIndex = Math.max(0, Math.min(index, lessonData.length - 1));
    const lesson = lessonData[activeIndex];
    const graph = getCompoundGraph(activeIndex);
    if (lesson.order === 10) {
      const fixedStageTenLayout = { 'ai-assistant': [50, 50], observability: [50, 20], evaluation: [50, 80] };
      graph.nodes.forEach((node) => {
        const position = fixedStageTenLayout[node.id];
        if (position) [node.x, node.y] = position;
      });
    }
    const showDiagram = lesson.showDiagram !== false;
    diagramPanel.hidden = !showDiagram;
    selectedNote.hidden = !showDiagram;
    scenarioBrief.hidden = showDiagram;
    const mergeTargets = new Set(lesson.nodes.filter((node) => ['container', 'container-wide', 'boundary-container'].includes(node.kind)).flatMap((node) => node.merge ?? []).map(canonicalId));
    const activeHighlights = new Set(lesson.highlight.map(canonicalId));
    const hasDottedPieces = lesson.nodes.some((node) => node.dotted || mergeTargets.has(canonicalId(node.id)) || activeHighlights.has(canonicalId(node.id)));
    lessonLegend.textContent = lesson.legend ?? (hasDottedPieces ? 'Dotted outline = pieces introduced together at this stage.' : '');
    lessonLegend.hidden = !lessonLegend.textContent;
    document.querySelector('[data-progress]').textContent = `STAGE ${String(lesson.order).padStart(2, '0')}`;
    document.querySelector('[data-lesson-eyebrow]').textContent = lesson.eyebrow;
    document.querySelector('[data-lesson-title]').textContent = lesson.title;
    document.querySelector('[data-lesson-summary]').textContent = lesson.summary;
    document.querySelector('[data-lesson-why]').textContent = lesson.why;
    document.querySelector('[data-lesson-without]').textContent = lesson.without;
    document.querySelector('[data-lesson-role]').textContent = lesson.role;
    document.querySelector('[data-lesson-tradeoff]').textContent = lesson.tradeoff;
    document.querySelector('[data-lesson-question]').textContent = lesson.question;
    document.querySelector('[data-previous]').disabled = activeIndex === 0;
    document.querySelector('[data-next]').textContent = activeIndex === lessonData.length - 1 ? 'Start again ↺' : activeIndex === 0 ? 'Start with the POC →' : 'Next stage →';
    document.querySelectorAll('.lesson-link').forEach((link) => link.classList.toggle('active', Number(link.dataset.index) === activeIndex));
    nodes.replaceChildren(...graph.nodes.map((node) => {
      const element = document.createElement('button');
      element.type = 'button'; element.className = `lesson-node${node.kind === 'container' ? ' lesson-group' : ''}${node.kind === 'container-wide' ? ' lesson-group-wide' : ''}${node.kind === 'boundary-container' ? ' lesson-boundary-group' : ''}${node.kind === 'merged-container' ? ' lesson-merged-group compound-tile' : ''}${activeHighlights.has(node.id) ? ' new-layer' : ''}`;
      element.dataset.nodeId = node.id; element.style.left = `${node.x}%`; element.style.top = `${node.y}%`;
      element.style.setProperty('--node-color', colors[node.kind] ?? '#176b58');
      const source = components[node.id];
      const mergedComponents = (node.merge ?? []).map((id) => components[id] ?? lesson.nodes.find((item) => item.id === id)).filter(Boolean);
      if (node.kind === 'merged-container') {
        element.innerHTML = `<span class="compound-count">${node.merge?.length ?? 0} components · click to inspect</span><b>${node.label}</b><small>${node.detail}</small>`;
      } else if (node.kind === 'container' || node.kind === 'container-wide' || node.kind === 'boundary-container') {
        const markers = mergedComponents.map((item) => `<i title="${item.title ?? item.label}" style="--merge-color:${colors[item.category ?? item.kind] ?? '#176b58'}"></i>`).join('');
        element.innerHTML = `<span class="merge-indicator"><span class="merge-markers" aria-hidden="true">${markers}</span><b>${node.label}</b><small>${node.detail}</small></span>`;
      } else {
        const layer = lesson.order === 1 && node.id === 'model' ? '' : (source?.layer ?? node.kind);
        element.innerHTML = `<b>${node.label}</b><small>${node.detail}</small>${layer ? `<em>${layer}</em>` : ''}`;
      }
      element.addEventListener('click', () => {
        setSelected(node, lesson);
        if (node.kind === 'merged-container' && node.merge?.length) openCompound(node, lesson);
      });
      return element;
    }));
    drawEdges(lesson, graph.connections);
    const first = graph.nodes.find((node) => activeHighlights.has(node.id)) ?? graph.nodes[0];
    if (first) setSelected(first, lesson);
    if (showDiagram && !didFitDiagram) requestAnimationFrame(() => { fitZoom(); didFitDiagram = true; });
  };

  document.querySelectorAll('.lesson-link').forEach((link) => link.addEventListener('click', () => renderLesson(Number(link.dataset.index))));
  document.querySelector('[data-previous]').addEventListener('click', () => renderLesson(activeIndex === 0 ? 0 : activeIndex - 1));
  document.querySelector('[data-next]').addEventListener('click', () => renderLesson(activeIndex === lessonData.length - 1 ? 0 : activeIndex + 1));
  document.querySelector('[data-zoom-out]').addEventListener('click', () => setZoom(diagramZoom - 0.1));
  document.querySelector('[data-zoom-reset]').addEventListener('click', () => setZoom(1));
  document.querySelector('[data-zoom-in]').addEventListener('click', () => setZoom(diagramZoom + 0.1));
  document.querySelector('[data-close-compound]').addEventListener('click', () => { document.querySelector('[data-compound-inspector]').hidden = true; });
  window.addEventListener('resize', () => drawEdges(lessonData[activeIndex], getCompoundGraph(activeIndex).connections));
  renderLesson(0);
</script>
