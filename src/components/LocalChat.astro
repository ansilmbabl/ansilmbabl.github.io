    const enableChat = () => { input?.removeAttribute('disabled'); if (input) input.placeholder = 'Ask a general question or explore the profile context…'; if (send) send.disabled = false; };
    const classifyLoadError = (error) => { const message = String(error?.message ?? error).toLowerCase(); if (message.includes('fetch') || message.includes('network') || message.includes('download') || message.includes('404')) return 'The model download could not finish. Check your connection and retry.'; if (message.includes('webgpu') || message.includes('gpu')) return 'WebGPU could not initialize. Retry to continue with the WASM-compatible local model path.'; if (message.includes('memory') || message.includes('allocation')) return 'This device may not have enough memory for the selected model. Choose a smaller model and retry.'; return 'The local model could not initialize. No generated answer will be shown until you retry.'; };
    const startLocalChat = async () => { if (modelReady || isBusy) return; if (!('WebAssembly' in window)) { fallbackMode = true; if (modelState) modelState.textContent = 'Model unavailable'; setStatus('WebAssembly is unavailable · retry the local model'); return; } isBusy = true; const started = performance.now(); const model = selectedModel(); if (startButton) { startButton.disabled = true; startButton.textContent = 'Loading…'; } if (modelSelect) modelSelect.disabled = true; if (changeModelButton) changeModelButton.hidden = true; if (modelState) modelState.textContent = 'Loading model'; setStatus(`Preparing ${model?.label ?? 'local model'}…`); if (downloadTitle) downloadTitle.textContent = `Downloading ${model?.label ?? 'local model'}`; if (downloadStage) downloadStage.textContent = 'Preparing the browser runtime'; if (downloadNote) downloadNote.textContent = 'This can take a few minutes on the first visit. It will be cached afterward.'; if (progressWrap) progressWrap.hidden = false; try { await getGenerator(); modelReady = true; if (modelState) modelState.textContent = 'Model ready'; readyDot?.classList.add('ready'); if (progressValue) progressValue.textContent = '100%'; if (progressBar) progressBar.style.width = '100%'; if (downloadTitle) downloadTitle.textContent = 'Local model ready'; if (downloadStage) downloadStage.textContent = 'Ready for private conversation'; if (downloadNote) downloadNote.textContent = `Cached in this browser · loaded in ${((performance.now() - started) / 1000).toFixed(1)}s`; if (startButton) startButton.hidden = true; if (changeModelButton) changeModelButton.hidden = false; enableChat(); setStatus('Ready'); } catch (error) { console.error(error); generatorPromise = undefined; fallbackMode = true; if (modelSelect) modelSelect.disabled = false; if (modelState) modelState.textContent = 'Model unavailable'; if (downloadTitle) downloadTitle.textContent = 'Model unavailable'; if (downloadStage) downloadStage.textContent = 'No generated answer will be shown until the model loads'; if (downloadNote) downloadNote.textContent = classifyLoadError(error); if (startButton) { startButton.disabled = false; startButton.textContent = 'Retry local model'; } setStatus('Model unavailable · retry to continue'); } finally { isBusy = false; } };
    startButton?.addEventListener('click', startLocalChat);
    modelSelect?.addEventListener('change', () => { if (!modelReady) { generatorPromise = undefined; fallbackMode = false; updateModelDetails(); setStatus(`${selectedModel()?.label ?? 'Model'} selected`); } });
    retrievalSelect?.addEventListener('change', () => { extractorPromise = undefined; chunkEmbeddings = undefined; updateModelDetails(); setStatus(`${selectedRetrievalModel()?.label ?? 'Retrieval model'} selected · it will load on the next grounded question`); });
    openCustomButton?.addEventListener('click', () => customDialog?.showModal());
    closeCustomButton?.addEventListener('click', () => customDialog?.close());
    customFiles?.addEventListener('change', async () => { const files = [...(customFiles.files ?? [])]; if (!files.length || !customText) return; const contents = await Promise.all(files.map((file) => new Promise((resolve) => { const reader = new FileReader(); reader.onload = () => resolve(`# ${file.name}\n${String(reader.result ?? '')}`); reader.onerror = () => resolve(''); reader.readAsText(file); }))); customText.value = [customText.value.trim(), ...contents.filter(Boolean)].filter(Boolean).join('\n\n'); setStatus(`${files.length} local file${files.length === 1 ? '' : 's'} ready to add`); });
    addCustomButton?.addEventListener('click', () => { const content = String(customText?.value ?? '').trim(); if (!content) { if (customStatus) customStatus.textContent = 'Add text or a .txt/.md file first'; return; } customEntries.push({ id: `custom-${Date.now()}`, title: `Your notes ${customEntries.length + 1}`, kind: 'Custom notes', origin: 'Your notes', href: '', content }); rebuildChunks(); renderCustomEntries(); if (customText) customText.value = ''; if (customFiles) customFiles.value = ''; if (customStatus) customStatus.textContent = `${customEntries.length} custom note${customEntries.length === 1 ? '' : 's'} · local only`; setStatus('Custom notes added to local retrieval'); customDialog?.close(); });
    clearCustomButton?.addEventListener('click', () => { customEntries.length = 0; rebuildChunks(); renderCustomEntries(); if (customText) customText.value = ''; if (customFiles) customFiles.value = ''; if (customStatus) customStatus.textContent = 'No custom notes'; setStatus('Custom notes cleared'); });
    changeModelButton?.addEventListener('click', () => { if (isBusy) return; modelReady = false; fallbackMode = false; generatorPromise = undefined; if (modelSelect) modelSelect.disabled = false; if (startButton) { startButton.hidden = false; startButton.disabled = false; startButton.textContent = 'Start local chat'; } changeModelButton.hidden = true; history.length = 0; if (messages) messages.innerHTML = ''; messages?.append(welcome); welcome?.removeAttribute('hidden'); if (generationMeta) generationMeta.hidden = true; setStatus('Choose another model to start a new conversation'); updateModelDetails(); });
    root.querySelectorAll('[data-prompt]').forEach((button) => button.addEventListener('click', () => { const question = button.dataset.prompt ?? ''; if (modelReady || fallbackMode) answer(question); else if (input) { input.value = question; resizeInput(); input.focus(); setStatus('Start local chat to send this question'); } }));
    root.querySelector('[data-reset]')?.addEventListener('click', () => { history.length = 0; if (messages) messages.innerHTML = ''; messages?.append(welcome); welcome?.removeAttribute('hidden'); if (generationMeta) generationMeta.hidden = true; setStatus('Ready for a new conversation'); input?.focus(); });
    if ('gpu' in navigator) { if (backendLabel) backendLabel.textContent = 'WebGPU available'; } else if (backendLabel) backendLabel.textContent = 'WASM fallback';
    updateModelDetails();
    const contextualPrompt = new URLSearchParams(location.search).get('prompt');
    if (contextualPrompt && input) { input.value = contextualPrompt; resizeInput(); setStatus('Start local chat to send this question'); }
  }
</script>
