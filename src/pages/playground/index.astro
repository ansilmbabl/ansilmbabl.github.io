---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const experiments = (await getCollection('playground')).filter((item) => !item.data.draft).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Playground"><div class="page-wrap"><p class="eyebrow">Playground / Experiments</p><h1>Small windows into <em>the lab.</em></h1><p class="intro">Interactive ideas, visual explanations, and small demos. This is where the work can be experienced rather than only described.</p><div class="playground-list">{experiments.map((item) => <article class="playground-item"><div><p class="eyebrow">{item.data.kind} · {item.data.status}</p><h2>{item.data.title}</h2><p>{item.data.description}</p></div><span class="playground-mark">{item.data.status === 'live' ? '↗' : '○'}</span></article>)}</div></div></BaseLayout>

<style>
  .playground-list { margin-top:70px; border-top:1px solid var(--line); }.playground-item { display:flex; justify-content:space-between; gap:30px; padding:27px 0; border-bottom:1px solid var(--line); }.playground-item h2 { font-size:30px; }.playground-item p:not(.eyebrow) { max-width:650px; margin:10px 0 0; color:#5d655d; }.playground-mark { color:var(--accent); font-size:30px; }
</style>
