---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const writing = (await getCollection('writing')).filter((post) => !post.data.draft).map((post) => ({ ...post, kind: 'Note', href: `/writing/${post.id}/`, date: post.data.published }));
const catchups = (await getCollection('catchups')).filter((post) => !post.data.draft).map((post) => ({ ...post, kind: 'AI catchup', href: `/catchups/${post.id}/`, date: post.data.published }));
const entries = [...writing, ...catchups].sort((a, b) => b.date.valueOf() - a.date.valueOf());
---
<BaseLayout title="Notes"><div class="page-wrap"><p class="eyebrow">Notes / Writing and signals</p><h1>Things I’m learning <em>in public.</em></h1><p class="intro">Technical notes, research trails, and human-reviewed signals from my experiments with AI.</p><div class="article-list">{entries.map((entry) => <a class="article-row" href={entry.href}><time>{entry.date.toLocaleDateString('en-IN', { year:'numeric', month:'short', day:'numeric' })}</time><div><p class="eyebrow">{entry.kind}</p><h3>{entry.data.title}</h3><p>{entry.data.description}</p></div><span class="reading">Open ↗</span></a>)}</div></div></BaseLayout>
