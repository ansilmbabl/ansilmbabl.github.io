---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const career = (await getCollection('career')).filter((entry) => !entry.data.draft).sort((a, b) => a.data.order - b.data.order);
const education = (await getCollection('education')).filter((entry) => !entry.data.draft).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="About">
  <div class="page-wrap">
    <p class="eyebrow">About / Context</p><h1>How I <em>work, learn,</em> and build.</h1>
    <div class="about-grid">
      <div><p>I’m an AI/ML Engineer and Data Scientist based in Bengaluru. I build systems that connect models to data, APIs, tools, and people—not just isolated demos.</p><p>My work has moved across financial services, pharmaceutical research, market research, oil and gas, trading-card intelligence, and internal workflow automation.</p></div>
      <div><p>I enjoy the space where technical decisions meet user feedback: understanding the real problem, making the system dependable, and iterating until it becomes useful.</p></div>
    </div>
    <div class="rule"></div><p class="eyebrow">Career history</p>
    <div class="timeline journey-timeline">{career.map((role) => <div class="timeline-row"><div class="timeline-date"><time>{role.data.period}</time></div><span class="timeline-marker"></span><div class="timeline-content"><h3>{role.data.title}</h3><p class="timeline-org">{role.data.organization}</p><p>{role.body}</p><div class="timeline-meta">{role.data.location && <small>{role.data.location}</small>}{role.data.current && <span class="current-badge">Current</span>}</div></div></div>)}</div>
    <div class="rule"></div><p class="eyebrow">Education</p>
    <div class="timeline journey-timeline">{education.map((entry) => <div class="timeline-row"><div class="timeline-date"><time>{entry.data.period}</time></div><span class="timeline-marker"></span><div class="timeline-content"><h3>{entry.data.qualification}</h3><p class="timeline-org">{entry.data.institution}</p>{entry.data.detail && <p>{entry.data.detail}</p>}<div class="timeline-meta">{entry.data.current && <span class="current-badge">Current</span>}</div></div></div>)}</div>
  </div>
</BaseLayout>

<style>
  .journey-timeline { position:relative; margin-top:45px; border-top:0; padding-left:0; }
  .journey-timeline::before { content:""; position:absolute; left:146px; top:7px; bottom:20px; width:1px; background:var(--line); }
  .journey-timeline .timeline-row { position:relative; display:grid; grid-template-columns:125px 1fr; column-gap:40px; padding:0 0 38px; border-bottom:0; }
  .timeline-date { padding-top:1px; color:var(--accent); font-size:12px; line-height:1.35; }
  .journey-timeline .timeline-row:last-child { padding-bottom:8px; }
  .timeline-marker { position:absolute; left:139px; top:6px; width:15px; height:15px; border:3px solid var(--paper); border-radius:50%; background:var(--accent); box-shadow:0 0 0 1px var(--accent); }
  .timeline-content { max-width:720px; padding:0 0 25px; border-bottom:1px solid var(--line); }
  .journey-timeline .timeline-row:last-child .timeline-content { border-bottom:0; }
  .timeline-top { display:flex; justify-content:space-between; gap:20px; margin-bottom:13px; color:var(--muted); font-size:11px; }
  .timeline-type { color:var(--accent); font-weight:700; letter-spacing:.12em; }
  .timeline-content h3 { font-size:25px; }
  .timeline-content .timeline-org { margin:5px 0 9px; color:var(--ink); font-size:14px; font-weight:600; }
  .timeline-content p:not(.timeline-org) { max-width:650px; margin:0; color:#5d655d; font-size:14px; }
  .timeline-meta { display:flex; align-items:center; gap:12px; margin-top:14px; color:var(--muted); }
  .current-badge { padding:3px 8px; border:1px solid #a4c7ba; border-radius:999px; color:var(--accent); font-size:10px; }
  @media (max-width:700px) { .journey-timeline { padding-left:32px; }.journey-timeline::before { left:7px; }.journey-timeline .timeline-row { display:block; }.timeline-date { margin-bottom:10px; }.timeline-marker { left:-32px; }.timeline-content h3 { font-size:22px; } }
</style>
