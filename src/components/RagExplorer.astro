<script>
  const story = document.querySelector('.rag-story');
  if (story) {
    const indexData = {
      ingest: ['INGEST', 'Keep the source attached to the text.', 'Documents can come from object storage, APIs, databases, wikis, or uploads. Parsing should preserve headings, tables, timestamps, and a pointer to the original source.', 'PDF', 'Payments operations handbook', '42 pages · Finance / Analyst · updated 2 days ago'],
      chunk: ['CHUNK', 'Give retrieval complete ideas to find.', 'Split by structure and meaning rather than an arbitrary page length. A small overlap can protect context at a boundary, but too much overlap adds noise and cost.', 'CHUNK', 'chunk_018 · escalation', 'Complete rule · 120 tokens · overlap 20'],
      embed: ['EMBED', 'Represent meaning as a vector.', 'An embedding maps text into a numerical space where related passages sit near one another. This is powerful for meaning, but it can miss exact IDs and names.', 'VECTOR', '[ 0.18 · 0.72 · 0.41 · 0.09 · … ]', '1536 dimensions · model version tracked'],
      store: ['INDEX', 'Make the right evidence fast to find.', 'Keep dense vectors, sparse terms, source metadata, timestamps, and access scope together. PostgreSQL with pgvector is one possible implementation.', 'INDEX', 'pgvector + sparse terms', 'source · freshness · tenant · access']
    };
    const indexButtons = story.querySelectorAll('[data-index-step]'); const indexKicker = story.querySelector('[data-index-kicker]'); const indexTitle = story.querySelector('[data-index-title]'); const indexCopy = story.querySelector('[data-index-copy]'); const visual = story.querySelector('[data-index-visual]');
    indexButtons.forEach((button) => button.addEventListener('click', () => { indexButtons.forEach((item) => item.classList.toggle('active', item === button)); const [k, t, c, badge, title, meta] = indexData[button.dataset.indexStep]; if(indexKicker) indexKicker.textContent=k; if(indexTitle) indexTitle.textContent=t; if(indexCopy) indexCopy.textContent=c; if(visual) visual.innerHTML=`<span class="doc-badge">${badge}</span><b>${title}</b><small>${meta}</small>`; }));
    story.querySelectorAll('[data-chunk]').forEach((button) => button.addEventListener('click', () => { story.querySelectorAll('[data-chunk]').forEach((item) => item.classList.toggle('active', item === button)); story.querySelectorAll('[data-chunk-panel]').forEach((panel) => panel.classList.toggle('hidden', panel.dataset.chunkPanel !== button.dataset.chunk)); }));
    const queryData = {
      rewrite: ['QUERY REWRITE', 'Make the user’s wording searchable.', '“What happens when a payment exception is unresolved?” becomes a clearer retrieval intent. The rewrite can drive more than one retrieval strategy.', 'payment exception · unresolved · escalation rule'],
      filter: ['ACCESS FILTER', 'Remove what this user cannot see.', 'Permission checks happen before context assembly. A relevant document is still an invalid source if the requester is not allowed to access it.', 'Finance · Analyst access · 3 candidates remain'],
      retrieve: ['RETRIEVAL', 'Search with complementary signals.', 'Dense search catches meaning. Sparse search catches exact terms, IDs, and names. A broad candidate set improves recall.', 'dense: 8 candidates · sparse: 6 candidates'],
      rerank: ['RERANKING', 'Spend more compute on fewer candidates.', 'A query-aware reranker evaluates the question and passage together, improving precision before generation.', 'top 2 passages → context window'],
      answer: ['AUGMENT + GENERATE', 'Answer from a compact evidence pack.', 'The model receives the question plus selected passages, metadata, and citation pointers. If support is missing, the safe answer is to say so.', 'answer + §4.2 citation + confidence']
    };
    const queryButtons = story.querySelectorAll('[data-query-step]'); const queryKicker = story.querySelector('[data-query-kicker]'); const queryTitle = story.querySelector('[data-query-title]'); const queryCopy = story.querySelector('[data-query-copy]'); const querySignal = story.querySelector('[data-query-signal]');
    queryButtons.forEach((button) => button.addEventListener('click', () => { queryButtons.forEach((item) => item.classList.toggle('active', item === button)); const [k,t,c,s] = queryData[button.dataset.queryStep]; if(queryKicker) queryKicker.textContent=k; if(queryTitle) queryTitle.textContent=t; if(queryCopy) queryCopy.textContent=c; if(querySignal) querySignal.textContent=s; }));
    const retrievalNotes = { hybrid:'Hybrid retrieval catches both meaning and exact business language. Reranking then spends more compute on a smaller, stronger set.', semantic:'Semantic search understands related language, but can miss exact policy IDs, names, and codes.', keyword:'Keyword search is precise for terms and identifiers, but can miss a good passage written with different words.', reranked:'Reranking improves precision after retrieval. It is usually more expensive, so apply it to a manageable candidate set.' };
    story.querySelectorAll('[data-retrieval]').forEach((button) => button.addEventListener('click', () => { story.querySelectorAll('[data-retrieval]').forEach((item) => item.classList.toggle('active', item === button)); const note=story.querySelector('[data-retrieval-note]'); if(note) note.textContent=retrievalNotes[button.dataset.retrieval]; }));
    const failures = { miss:['Recall fell because the relevant chunk never entered the candidate set.','Improve parsing, query rewriting, chunk boundaries, or retrieval coverage. Do not ask the generator to guess.','Next move: inspect retrieval recall and add a representative test question.'], stale:['The answer used a document that was no longer current.','Track source timestamps and deletion events, and define a freshness policy for each collection.','Next move: invalidate or re-index stale chunks before generation.'], access:['A relevant private chunk was blocked before context assembly.','That is the correct outcome. Access-controlled retrieval is a product requirement, not a ranking failure.','Next move: log the decision without exposing the protected text.'], unsupported:['The retrieved context did not support the requested claim.','The system should cite what it knows, state the gap, and ask for a narrower question or more evidence.','Next move: abstain, route to review, or retrieve again with a refined query.'] };
    story.querySelectorAll('[data-failure]').forEach((button) => button.addEventListener('click', () => { story.querySelectorAll('[data-failure]').forEach((item) => item.classList.toggle('active', item === button)); const [t,c,a]=failures[button.dataset.failure]; const title=story.querySelector('[data-failure-title]'); const copy=story.querySelector('[data-failure-copy]'); const action=story.querySelector('[data-failure-action]'); if(title) title.textContent=t; if(copy) copy.textContent=c; if(action) action.textContent=a; }));
  }
</script>
