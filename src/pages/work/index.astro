---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Work"><div class="page-wrap"><p class="eyebrow">Work / Case studies</p><h1>Things I’ve built, <em>explained.</em></h1><p class="intro">A few projects across GenAI, agent systems, computer vision, and production engineering. The useful part is not only what shipped—it’s the reasoning behind it.</p><div class="grid">{projects.map((project) => <a class="card" href={`/work/${project.id}/`}><div class="card-meta"><span>{project.data.category}</span><span>{project.data.confidential ? 'Sanitized' : 'Public'} ↗</span></div><h3>{project.data.title}</h3><p>{project.data.description}</p><div class="card-bottom"><div class="tags">{project.data.technologies.map((tag) => <span class="tag">{tag}</span>)}</div><span>Read →</span></div></a>)}</div></div></BaseLayout>
