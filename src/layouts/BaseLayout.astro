---
interface Props { title: string; description?: string; }
const { title, description = 'Ansil M B — Data Scientist and AI/ML Engineer.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} /><link rel="icon" href="data:," />
    <title>{title} — Ansil M B</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Ansil M B home">Ansil M B</a>
      <nav aria-label="Primary navigation"><a href="/work/">Work</a><a href="/projects/">Projects</a><a href="/notes/">Notes</a><a href="/playground/">Playground</a><a href="/about/">Journey</a><a href="mailto:ansiljbs@gmail.com">Email ↗</a></nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><span>© 2026 Ansil M B</span><span>Bengaluru, India</span><a href="/resume.pdf">Resume ↗</a></footer>
  </body>
</html>

<style is:global>
  :root { --ink:#202522; --paper:#f8f7f2; --muted:#747a72; --soft:#ebece5; --line:#d9dcd2; --accent:#176b58; --serif:Georgia,'Times New Roman',serif; }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; color:var(--ink); background:var(--paper); font-family:Arial,Helvetica,sans-serif; line-height:1.6; } a { color:inherit; text-decoration:none; } a:hover { color:var(--accent); }
  .site-header,.site-footer,.page-wrap { width:min(980px,calc(100% - 48px)); margin:0 auto; } .site-header { display:flex; justify-content:space-between; align-items:center; padding:26px 0; border-bottom:1px solid var(--line); } .brand { font-size:15px; font-weight:700; letter-spacing:-.02em; } nav { display:flex; gap:22px; color:var(--muted); font-size:13px; } nav a:hover { color:var(--accent); }
  .page-wrap { padding:92px 0 120px; } .eyebrow { margin:0 0 18px; color:var(--accent); font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; } h1,h2,h3 { margin:0; letter-spacing:-.045em; line-height:1.08; } h1 { max-width:850px; font-size:clamp(48px,8vw,94px); font-weight:700; } h2 { font-size:clamp(34px,5vw,54px); } h1 em,h2 em { font-family:var(--serif); font-weight:400; } .intro { max-width:620px; margin:28px 0 0; color:#555d56; font-size:18px; } .rule { height:1px; margin:72px 0; background:var(--line); } .button { display:inline-block; margin-top:30px; padding:11px 15px; border:1px solid var(--ink); border-radius:2px; font-size:13px; } .button:hover { color:var(--paper); background:var(--ink); }
  .site-footer { display:flex; justify-content:space-between; gap:15px; padding:20px 0 28px; border-top:1px solid var(--line); color:var(--muted); font-size:11px; } .site-footer a { color:var(--accent); }
  .grid { display:grid; grid-template-columns:repeat(2,1fr); gap:0 45px; margin-top:48px; } .card { display:flex; flex-direction:column; min-height:245px; padding:22px 0; border-top:1px solid var(--line); } .card:hover h3 { color:var(--accent); } .card-meta { display:flex; justify-content:space-between; color:var(--muted); font-size:11px; } .card h3 { margin:42px 0 10px; font-size:28px; } .card p { margin:0; color:#5d655d; font-size:14px; } .card-bottom { display:flex; justify-content:space-between; align-items:end; gap:15px; margin-top:auto; padding-top:16px; color:var(--accent); font-size:12px; } .tags { display:flex; flex-wrap:wrap; gap:6px; } .tag { padding:2px 7px; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:10px; }
  .timeline { margin-top:48px; border-top:1px solid var(--line); } .timeline-row { display:grid; grid-template-columns:150px 1fr; gap:30px; padding:24px 0; border-bottom:1px solid var(--line); } .timeline-row time { color:var(--accent); font-size:12px; } .timeline-row h3 { font-size:22px; } .timeline-row p { max-width:650px; margin:7px 0 0; color:#5d655d; } .timeline-row small { color:var(--muted); }
  .article-list { margin-top:46px; border-top:1px solid var(--line); } .article-row { display:grid; grid-template-columns:140px 1fr 100px; gap:25px; align-items:start; padding:25px 0; border-bottom:1px solid var(--line); } .article-row time,.article-row .reading { color:var(--muted); font-size:11px; } .article-row h3 { font-size:24px; } .article-row p { margin:7px 0 0; color:#5d655d; font-size:14px; } .article-row .reading { text-align:right; color:var(--accent); }
  .article { max-width:750px; } .article-header { margin-bottom:55px; } .article-header h1 { font-size:clamp(45px,7vw,78px); } .article-header .intro { font-size:17px; } .article-body { font-family:var(--serif); font-size:19px; line-height:1.75; } .article-body h2 { margin:48px 0 17px; font-family:Arial,Helvetica,sans-serif; font-size:31px; } .article-body p { margin:0 0 22px; } .article-body code { padding:2px 5px; background:var(--soft); font-family:monospace; font-size:.85em; } .article-body pre { overflow:auto; padding:18px; background:#202522; color:#f8f7f2; font:14px monospace; }
  .case-header { display:grid; grid-template-columns:1fr 250px; gap:55px; align-items:end; } .case-header h1 { font-size:clamp(46px,7vw,84px); } .case-header .side { border-left:1px solid var(--line); padding-left:22px; color:var(--muted); font-size:14px; } .case-header .side strong { display:block; margin-bottom:7px; color:var(--accent); font-size:11px; text-transform:uppercase; } .case-body { display:grid; grid-template-columns:175px 1fr; gap:55px; margin-top:80px; } .case-body aside { color:var(--accent); font-size:11px; text-transform:uppercase; } .case-content { max-width:700px; font-family:var(--serif); font-size:19px; line-height:1.7; } .case-content h2 { margin:0 0 18px; font-family:Arial,Helvetica,sans-serif; font-size:32px; } .case-content p { margin:0 0 32px; } .case-content .callout { margin:42px 0; padding:22px; border-left:3px solid var(--accent); background:var(--soft); font-family:Arial,Helvetica,sans-serif; font-size:19px; line-height:1.4; }
  .about-grid { display:grid; grid-template-columns:1fr 1fr; gap:65px; margin-top:60px; } .about-grid p { color:#555d56; font-size:17px; } .link-list { margin-top:36px; border-top:1px solid var(--line); } .link-list a { display:flex; justify-content:space-between; padding:13px 0; border-bottom:1px solid var(--line); color:var(--muted); font-size:13px; } .link-list a:hover { color:var(--accent); }
  @media (max-width:700px) { .site-header,.site-footer,.page-wrap { width:calc(100% - 34px); } nav { gap:12px; } nav a:not(:last-child) { display:none; } .page-wrap { padding:66px 0 85px; } .grid,.about-grid,.case-header { grid-template-columns:1fr; } .article-row { grid-template-columns:1fr; gap:7px; } .article-row .reading { text-align:left; } .timeline-row { grid-template-columns:1fr; gap:6px; } .case-body { grid-template-columns:1fr; gap:22px; margin-top:55px; } .site-footer { flex-wrap:wrap; } }
</style>
