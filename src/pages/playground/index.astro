---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
const experiments = (await getCollection('playground')).filter((item) => !item.data.draft).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Playground"><div class="page-wrap"><p class="eyebrow">Playground / Experiments</p><h1>Small windows into <em>the lab.</em></h1><p class="intro">Experiments, visual explanations, and demos in progress. Each one is a small question made interactive.</p><div class="playground-grid">{experiments.map((item) => <a class={`playground-tile tile-${item.id}`} href={item.data.demoPath ?? `/playground/${item.id}/`}><div class="tile-top"><span>{item.data.status}</span><b>↗</b></div><div class="tile-preview">{item.id === 'local-agent-catchup' && <><span class="preview-line strong"></span><span class="preview-line"></span><span class="preview-line short"></span><div class="preview-pills"><i></i><i></i><i></i></div></>}{item.id === 'rag-retrieval-map' && <div class="preview-flow"><i>Q</i><b>→</b><i>R</i><b>→</b><i>E</i><b>→</b><i>A</i></div>}{item.id === 'agent-workflow-simulator' && <div class="preview-trace"><i></i><span></span><i></i><span></span><i class="warn"></i><span></span><i></i></div>}</div><p class="tile-kind">{item.data.kind}</p><h2>{item.data.title}</h2><p class="tile-description">{item.data.description}</p><span class="tile-action">Explore experiment →</span></a>)}</div></div></BaseLayout>

<style>
  .playground-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:18px; margin-top:70px; }.playground-tile { display:flex; flex-direction:column; min-height:405px; padding:20px; border:1px solid var(--line); background:#f1f2eb; transition:transform .2s ease,background .2s ease,border-color .2s ease; }.playground-tile:hover { transform:translateY(-4px); border-color:var(--accent); background:#eaf0e8; }.tile-top { display:flex; justify-content:space-between; color:var(--accent); font-size:11px; text-transform:uppercase; }.tile-top b { font-size:18px; font-weight:400; }.tile-preview { display:flex; flex-direction:column; justify-content:center; min-height:132px; margin:25px 0 27px; padding:20px; border:1px solid var(--line); background:var(--paper); }.tile-kind { margin:0 0 8px; color:var(--accent); font-size:10px; font-weight:700; letter-spacing:.1em; text-transform:uppercase; }.playground-tile h2 { font-size:30px; }.tile-description { max-width:470px; margin:10px 0 24px; color:#5d655d; font-size:14px; }.tile-action { margin-top:auto; color:var(--accent); font-size:12px; }.preview-line { display:block; width:78%; height:8px; margin:7px 0; background:#c9d8cd; }.preview-line.strong { width:92%; height:13px; background:var(--accent); }.preview-line.short { width:52%; }.preview-pills { display:flex; gap:7px; margin-top:16px; }.preview-pills i { display:block; width:33px; height:8px; border:1px solid #a4c7ba; border-radius:99px; }.preview-flow { display:flex; align-items:center; justify-content:center; gap:12px; color:var(--accent); font-size:17px; }.preview-flow i { display:grid; place-items:center; width:34px; height:34px; border:1px solid var(--accent); border-radius:50%; font-style:normal; font-size:11px; }.preview-flow b { font-weight:400; color:var(--muted); }.preview-trace { display:flex; align-items:center; justify-content:center; }.preview-trace i { width:17px; height:17px; border:3px solid var(--paper); border-radius:50%; background:var(--accent); box-shadow:0 0 0 1px var(--accent); }.preview-trace i.warn { background:#c58745; box-shadow:0 0 0 1px #c58745; }.preview-trace span { width:55px; height:1px; background:var(--line); }
  @media(max-width:700px) { .playground-grid { grid-template-columns:1fr; margin-top:50px; }.playground-tile h2 { font-size:27px; } }
</style>
