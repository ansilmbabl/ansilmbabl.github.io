  .lesson-node.lesson-group:before,.lesson-node.lesson-group:after,.lesson-node.lesson-group-wide:before,.lesson-node.lesson-group-wide:after{display:none}
  .lesson-node.lesson-group:before,.lesson-node.lesson-group:after,.lesson-node.lesson-group-wide:before,.lesson-node.lesson-group-wide:after,.lesson-node.lesson-boundary-group:before,.lesson-node.lesson-boundary-group:after{display:none}
  .merge-indicator{display:grid;justify-items:center;gap:5px;min-width:150px}
