</style>

<style is:global>
  .lesson-group-label{margin:18px 8px 4px;padding-top:12px;border-top:1px solid var(--line);color:var(--accent);font-size:9px;font-weight:700;letter-spacing:.12em;text-transform:uppercase}
  .lesson-group-label:first-child{margin-top:10px;border-top:0;padding-top:0}
