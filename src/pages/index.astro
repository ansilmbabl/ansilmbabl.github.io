---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('work')).filter((entry) => entry.data.featured).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('writing')).filter((entry) => !entry.data.draft).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf()).slice(0, 2);
---
<BaseLayout title="Ansil M B" description="Ansil M B is an AI/ML Engineer building production AI systems across GenAI, computer vision, and intelligent automation.">
  <div class="page-wrap home">
    <p class="eyebrow">AI/ML Engineer · Bengaluru, India</p>
    <h1>I build AI systems that survive contact with <em>production.</em></h1>
    <p class="intro">I’m Ansil. I work across Generative AI, computer vision, and intelligent automation—connecting models to real workflows, real users, and real constraints.</p>
    <a class="button" href="/work/">See how I work ↓</a>
    <div class="rule"></div>
    <p class="eyebrow">A few signals</p>
    <div class="grid" style="grid-template-columns:repeat(4,1fr);margin-top:25px">
      <div><h2>3+</h2><p>years building AI systems</p></div>
      <div><h2>5</h2><p>agents in one production system</p></div>
      <div><h2>14</h2><p>tools exposed through MCP</p></div>
      <div><h2>500</h2><p>internal users supported</p></div>
    </div>
    <div class="rule"></div>
    <p class="eyebrow">Selected work</p>
    <div class="grid">
      {projects.map((project) => <a class="card" href={`/work/${project.id}/`}>
        <div class="card-meta"><span>{project.data.category}</span><span>{project.data.confidential ? 'Sanitized case study' : 'Case study'} ↗</span></div>
        <h3>{project.data.title}</h3><p>{project.data.description}</p>
        <div class="card-bottom"><div class="tags">{project.data.technologies.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}</div><span>Read →</span></div>
      </a>)}
    </div>
    <div class="rule"></div>
    <div style="display:flex;justify-content:space-between;align-items:end;gap:25px"><div><p class="eyebrow">From the notebook</p><h2>Ideas in <em>progress.</em></h2></div><a href="/writing/">All writing →</a></div>
    <div class="article-list">{posts.map((post) => <a class="article-row" href={`/writing/${post.id}/`}><time>{post.data.published.toLocaleDateString('en-IN', { year:'numeric', month:'short', day:'numeric' })}</time><div><h3>{post.data.title}</h3><p>{post.data.description}</p></div><span class="reading">{post.data.readingTime ?? 'Notes'} ↗</span></a>)}</div>
  </div>
</BaseLayout>
