    form?.addEventListener('submit', (event) => { event.preventDefault(); answer(input?.value ?? ''); });
    stop?.addEventListener('click', () => { stopRequested = true; generationController?.abort(); });
    input?.addEventListener('input', resizeInput);
    input?.addEventListener('keydown', (event) => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); form?.requestSubmit(); } });
    const enableChat = () => { input?.removeAttribute('disabled'); if (input) input.placeholder = 'Ask about Ansil or try a general AI question…'; if (send) send.disabled = false; };
    const classifyLoadError = (error) => { const message = String(error?.message ?? error).toLowerCase(); if (message.includes('fetch') || message.includes('network') || message.includes('download') || message.includes('404')) return 'The model download could not finish. Check your connection and retry.'; if (message.includes('webgpu') || message.includes('gpu')) return 'WebGPU could not initialize. Retry to continue with the WASM-compatible local model path.'; if (message.includes('memory') || message.includes('allocation')) return 'This device may not have enough memory for the selected model. Choose a smaller model and retry.'; return 'The local model could not initialize. No generated answer will be shown until you retry.'; };
    const startLocalChat = async () => { if (modelReady || isBusy) return; if (!('WebAssembly' in window)) { fallbackMode = true; if (modelState) modelState.textContent = 'Model unavailable'; setStatus('WebAssembly is unavailable · retry the local model'); return; } isBusy = true; const started = performance.now(); const model = selectedModel(); if (startButton) { startButton.disabled = true; startButton.textContent = 'Loading…'; } if (modelSelect) modelSelect.disabled = true; if (changeModelButton) changeModelButton.hidden = true; if (modelState) modelState.textContent = 'Loading model'; setStatus(`Preparing ${model?.label ?? 'local model'}…`); if (downloadTitle) downloadTitle.textContent = `Downloading ${model?.label ?? 'local model'}`; if (downloadStage) downloadStage.textContent = 'Preparing the browser runtime'; if (downloadNote) downloadNote.textContent = 'This can take a few minutes on the first visit. It will be cached afterward.'; if (progressWrap) progressWrap.hidden = false; try { await getGenerator(); modelReady = true; if (modelState) modelState.textContent = 'Model ready'; readyDot?.classList.add('ready'); if (progressValue) progressValue.textContent = '100%'; if (progressBar) progressBar.style.width = '100%'; if (downloadTitle) downloadTitle.textContent = 'Local model ready'; if (downloadStage) downloadStage.textContent = 'Ready for private conversation'; if (downloadNote) downloadNote.textContent = `Cached in this browser · loaded in ${((performance.now() - started) / 1000).toFixed(1)}s`; if (startButton) startButton.hidden = true; if (changeModelButton) changeModelButton.hidden = false; enableChat(); setStatus('Ready'); } catch (error) { console.error(error); generatorPromise = undefined; fallbackMode = true; if (modelSelect) modelSelect.disabled = false; if (modelState) modelState.textContent = 'Model unavailable'; if (downloadTitle) downloadTitle.textContent = 'Model unavailable'; if (downloadStage) downloadStage.textContent = 'No generated answer