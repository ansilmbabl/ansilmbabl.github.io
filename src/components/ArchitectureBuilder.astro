---
import { getCollection } from 'astro:content';

const lessons = (await getCollection('architectureLessons')).sort((a, b) => a.data.order - b.data.order).map((entry) => ({ id: entry.id, ...entry.data }));
const componentCatalog = (await getCollection('architectureComponents')).map((entry) => ({ id: entry.id, ...entry.data }));
---

<section class="architecture-builder" aria-label="AI systems learning journey">
  <header class="builder-hero"><div><span class="builder-kicker">AI SYSTEMS · INTERACTIVE LEARNING</span><h2>Grow an AI system one decision at a time.</h2><p>Start with a request and a response. Then add the layers that make the system useful, safe, measurable, and ready to operate.</p></div><div class="hero-note"><span>09</span><p>From first idea<br /><em>to production system.</em></p></div></header>

  <div class="story-layout">
    <aside class="lesson-rail"><div class="rail-heading"><span class="builder-kicker">THE SYSTEM STORY</span><small data-progress>1 / 9</small></div><nav data-lesson-list aria-label="Architecture lessons"></nav></aside>
    <main class="lesson-main">
      <section class="lesson-heading"><span class="builder-kicker" data-lesson-eyebrow></span><h1 data-lesson-title></h1><p data-lesson-summary></p></section>
      <section class="lesson-diagram-panel"><div class="panel-label"><span>HOW THE SYSTEM FITS TOGETHER</span><span>Step-by-step view</span></div><div class="lesson-viewport"><div class="lesson-stage"><svg class="lesson-edges" data-lesson-edges viewBox="0 0 1000 600" aria-hidden="true"><defs><marker id="lesson-arrow" markerWidth="8" markerHeight="8" refX="7" refY="4" orient="auto" markerUnits="strokeWidth"><path d="M0,0 L8,4 L0,8 z" fill="#176b58"></path></marker></defs></svg><div class="lesson-nodes" data-lesson-nodes></div></div></div><div class="diagram-help"><span>request flow →</span><span>Click a component to inspect it</span><span>→ response / feedback</span></div></section>
      <section class="selected-note" data-selected-note><span class="builder-kicker">SELECTED COMPONENT</span><h3 data-selected-title>Start with the diagram</h3><p data-selected-copy>Each new layer exists to solve a specific problem. Select a component to see its role in the larger system.</p><div class="selected-facts"><div><small>ROLE</small><p data-selected-role>—</p></div><div><small>FAILURE TO WATCH</small><p data-selected-risk>—</p></div><div><small>TRADE-OFF</small><p data-selected-tradeoff>—</p></div></div></section>
      <section class="lesson-explanation"><div><span class="builder-kicker">WHY THIS LAYER EXISTS</span><h2 data-lesson-why></h2><p data-lesson-without></p></div><div class="lesson-details"><div><small>IN THE SYSTEM</small><p data-lesson-role></p></div><div><small>DESIGN TRADE-OFF</small><p data-lesson-tradeoff></p></div><div class="reflection"><small>QUESTION TO CARRY FORWARD</small><p data-lesson-question></p></div></div></section>
      <div class="lesson-navigation"><button type="button" data-previous>← Previous</button><button type="button" class="next-lesson" data-next>Next layer →</button></div>
    </main>
  </div>
  <p class="builder-note">A read-only learning path for thinking through AI application architecture. The editable canvas can come later.</p>
</section>

<style is:global>
  .architecture-builder{margin-top:0}.builder-kicker{color:var(--accent);font-size:10px;font-weight:700;letter-spacing:.14em}.builder-hero{display:flex;justify-content:space-between;gap:35px;padding:0 0 34px;border-bottom:1px solid var(--line)}.builder-hero h2{max-width:720px;margin:13px 0 10px;font-size:clamp(34px,5vw,62px);line-height:.98}.builder-hero>div:first-child p{max-width:670px;margin:0;color:#4f5a52;font-family:var(--serif);font-size:19px;line-height:1.45}.hero-note{display:flex;gap:12px;min-width:190px;padding-top:8px}.hero-note>span{color:var(--accent);font-size:11px;font-weight:700}.hero-note p{margin:0;color:var(--muted);font-size:12px;line-height:1.45}.hero-note em{color:var(--ink);font-family:var(--serif);font-size:16px;font-style:normal}.story-layout{display:grid;grid-template-columns:190px minmax(0,1fr);gap:35px;margin-top:32px}.lesson-rail{padding-top:8px}.rail-heading{display:flex;justify-content:space-between;gap:10px;align-items:center;padding-bottom:13px;border-bottom:1px solid var(--line)}.rail-heading small{color:var(--muted);font-size:10px}.lesson-rail nav{display:grid;gap:0;margin-top:10px}.lesson-link{position:relative;padding:12px 10px 12px 18px;border:0;border-left:2px solid transparent;background:transparent;color:var(--muted);text-align:left;cursor:pointer;font-size:11px;line-height:1.3}.lesson-link:before{content:'';position:absolute;left:-5px;top:17px;width:7px;height:7px;border:1px solid var(--line);border-radius:50%;background:var(--paper)}.lesson-link.active{border-left-color:var(--accent);color:var(--accent);background:#dfece4}.lesson-link.active:before{border-color:var(--accent);background:var(--accent)}.lesson-link span{display:block;margin-bottom:4px;color:var(--accent);font-size:9px;font-weight:700;letter-spacing:.1em}.lesson-main{min-width:0}.lesson-heading{padding-bottom:26px}.lesson-heading h1{max-width:820px;margin:13px 0 12px;font-size:clamp(35px,5.2vw,65px);line-height:.98}.lesson-heading p{max-width:720px;margin:0;color:#4f5a52;font-family:var(--serif);font-size:20px;line-height:1.45}.lesson-diagram-panel{padding:18px;border:1px solid var(--line);background:#eef0e9}.panel-label,.diagram-help{display:flex;justify-content:space-between;gap:15px;color:var(--accent);font-size:10px;font-weight:700;letter-spacing:.12em}.panel-label span:last-child,.diagram-help{color:var(--muted);font-weight:400;letter-spacing:0}.lesson-viewport{margin-top:14px;overflow:auto;border:1px dashed #a4c7ba;background:radial-gradient(circle at 1px 1px,#c7d5ca 1px,transparent 0) 0 0/18px 18px,#e8ece4}.lesson-stage{position:relative;width:1000px;height:600px}.lesson-edges{position:absolute;inset:0;width:100%;height:100%;overflow:visible}.lesson-edge{fill:none;stroke:#176b58;stroke-width:2.3;marker-end:url(#lesson-arrow)}.lesson-edge-label{fill:#4f6e5e;font:11px Arial,sans-serif;paint-order:stroke;stroke:#e8ece4;stroke-width:6px;stroke-linejoin:round}.lesson-edge-dot{fill:#176b58;stroke:#e8ece4;stroke-width:2}.lesson-nodes{position:absolute;inset:0}.lesson-node{position:absolute;width:160px;min-height:82px;padding:14px;border:1px solid var(--node-color,#87a995);border-radius:4px;background:var(--paper);box-shadow:3px 3px 0 rgba(39,76,58,.08);cursor:pointer;transform:translate(-50%,-50%);text-align:left}.lesson-node:before,.lesson-node:after{content:'';position:absolute;width:15px;height:15px;border:1px solid var(--node-color,#87a995);border-radius:50%;background:var(--paper)}.lesson-node:before{left:-9px;top:calc(50% - 8px)}.lesson-node:after{right:-9px;top:calc(50% - 8px)}.lesson-node:hover,.lesson-node.active{box-shadow:0 0 0 3px rgba(23,107,88,.18),3px 3px 0 rgba(39,76,58,.08)}.lesson-node.new-layer{background:#e1eee6}.lesson-node b,.lesson-node small,.lesson-node em{display:block}.lesson-node b{font-size:14px}.lesson-node small{margin-top:5px;color:var(--muted);font-size:10px;line-height:1.3}.lesson-node em{margin-top:10px;color:var(--node-color,#176b58);font-size:9px;font-style:normal;letter-spacing:.08em;text-transform:uppercase}.diagram-help{margin-top:12px}.selected-note{margin-top:16px;padding:18px;border-left:3px solid var(--accent);background:#dfece4}.selected-note h3{margin:10px 0 7px;font-size:24px}.selected-note>p{max-width:760px;margin:0;color:#4f5a52;font-size:14px;line-height:1.5}.selected-facts{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:18px;padding-top:14px;border-top:1px solid #a4c7ba}.selected-facts small,.lesson-details small{color:var(--accent);font-size:9px;font-weight:700;letter-spacing:.1em}.selected-facts p,.lesson-details p{margin:5px 0 0;color:#4f5a52;font-size:12px;line-height:1.45}.lesson-explanation{display:grid;grid-template-columns:1.15fr .85fr;gap:30px;margin-top:16px;padding:22px;border:1px solid var(--line);background:#f1f2eb}.lesson-explanation h2{max-width:560px;margin:11px 0 12px;font-size:clamp(27px,3.8vw,43px);line-height:1.02}.lesson-explanation>div:first-child>p{margin:0;color:#5d655d;font-family:var(--serif);font-size:17px;line-height:1.5}.lesson-details{display:grid;gap:15px}.lesson-details>div{padding-bottom:14px;border-bottom:1px solid var(--line)}.lesson-details .reflection{padding:13px;border:1px solid #a4c7ba;background:#dfece4}.lesson-navigation{display:flex;justify-content:space-between;gap:15px;margin-top:18px}.lesson-navigation button{padding:11px 14px;border:1px solid var(--line);background:transparent;color:var(--ink);cursor:pointer;font-size:12px}.lesson-navigation button:hover,.lesson-navigation .next-lesson{border-color:var(--accent);background:var(--accent);color:var(--paper)}.lesson-navigation button:disabled{opacity:.35;cursor:not-allowed}.builder-note{margin:17px 0 0;color:var(--muted);font-size:10px}
  @media(max-width:850px){.story-layout{grid-template-columns:1fr}.lesson-rail{padding:0}.lesson-rail nav{display:flex;overflow:auto;border-bottom:1px solid var(--line)}.lesson-link{min-width:125px;border-left:0;border-bottom:2px solid transparent}.lesson-link:before{display:none}.lesson-link.active{border-bottom-color:var(--accent);background:transparent}.lesson-link span{white-space:nowrap}.lesson-explanation{grid-template-columns:1fr}.selected-facts{grid-template-columns:1fr 1fr}}
  @media(max-width:600px){.builder-hero{display:block}.hero-note{margin-top:22px}.lesson-heading h1{font-size:42px}.lesson-heading p{font-size:18px}.lesson-diagram-panel{padding:13px}.diagram-help{display:block}.diagram-help span{display:inline-block;margin:5px 12px 0 0}.selected-facts{grid-template-columns:1fr}.lesson-navigation{position:sticky;bottom:0;padding:10px 0;background:var(--paper)}}
</style>

<script define:vars={{ lessons, componentCatalog }}>
  const lessonData = lessons; const components = Object.fromEntries(componentCatalog.map((item) => [item.id, item])); const colors = { boundary: '#7d4f73', core: '#176b58', generation: '#176b58', action: '#8a633a', knowledge: '#47765b', data: '#47765b', safety: '#a66d3b', performance: '#637747', quality: '#4d687f', operations: '#4d687f', security: '#a66d3b', runtime: '#637747' }; let activeIndex = 0; let selectedNode = null;
  const nodes = document.querySelector('[data-lesson-nodes]'); const edges = document.querySelector('[data-lesson-edges]');
  const setSelected = (node, item) => { selectedNode = node.id; document.querySelectorAll('.lesson-node').forEach((element) => element.classList.toggle('active', element.dataset.nodeId === node.id)); const source = components[node.id]; document.querySelector('[data-selected-title]').textContent = node.label; document.querySelector('[data-selected-copy]').textContent = source?.description ?? node.detail; document.querySelector('[data-selected-role]').textContent = source?.solves ?? node.detail; document.querySelector('[data-selected-risk]').textContent = source?.risks ?? item.without; document.querySelector('[data-selected-tradeoff]').textContent = source?.tradeoff ?? item.tradeoff; };
  const drawEdges = (lesson) => { edges.querySelectorAll('.dynamic-lesson-edge').forEach((edge) => edge.remove()); const stage = document.querySelector('.lesson-stage'); const stageRect = stage.getBoundingClientRect(); lesson.connections.forEach((connection) => { const from = document.querySelector(`[data-node-id="${connection.from}"]`); const to = document.querySelector(`[data-node-id="${connection.to}"]`); if (!from || !to) return; const fromRect = from.getBoundingClientRect(); const toRect = to.getBoundingClientRect(); const fromCenter = { x: fromRect.left - stageRect.left + fromRect.width / 2, y: fromRect.top - stageRect.top + fromRect.height / 2 }; const toCenter = { x: toRect.left - stageRect.left + toRect.width / 2, y: toRect.top - stageRect.top + toRect.height / 2 }; const horizontal = Math.abs(toCenter.x - fromCenter.x) >= Math.abs(toCenter.y - fromCenter.y); let sx; let sy; let tx; let ty; let pathData; let labelX; let labelY; if (horizontal) { const forward = toCenter.x >= fromCenter.x; sx = (forward ? fromRect.right : fromRect.left) - stageRect.left; sy = fromCenter.y; tx = (forward ? toRect.left : toRect.right) - stageRect.left; ty = toCenter.y; const midX = sx + (tx - sx) / 2; pathData = `M ${sx} ${sy} H ${midX} V ${ty} H ${tx}`; labelX = midX + 6; labelY = (sy + ty) / 2 - 7; } else { const downward = toCenter.y >= fromCenter.y; sx = fromCenter.x; sy = (downward ? fromRect.bottom : fromRect.top) - stageRect.top; tx = toCenter.x; ty = (downward ? toRect.top : toRect.bottom) - stageRect.top; const midY = sy + (ty - sy) / 2; pathData = `M ${sx} ${sy} V ${midY} H ${tx} V ${ty}`; labelX = (sx + tx) / 2 + 6; labelY = midY - 7; } const group = document.createElementNS('http://www.w3.org/2000/svg', 'g'); group.classList.add('dynamic-lesson-edge'); const path = document.createElementNS('http://www.w3.org/2000/svg', 'path'); path.setAttribute('d', pathData); path.setAttribute('class', 'lesson-edge'); group.append(path); [ [sx, sy], [tx, ty] ].forEach(([x, y]) => { const dot = document.createElementNS('http://www.w3.org/2000/svg', 'circle'); dot.setAttribute('cx', String(x)); dot.setAttribute('cy', String(y)); dot.setAttribute('r', '4'); dot.setAttribute('class', 'lesson-edge-dot'); group.append(dot); }); if (connection.label) { const label = document.createElementNS('http://www.w3.org/2000/svg', 'text'); label.textContent = connection.label; label.setAttribute('x', String(labelX)); label.setAttribute('y', String(labelY)); label.setAttribute('class', 'lesson-edge-label'); group.append(label); } edges.append(group); }); };
  const renderLesson = (index) => { activeIndex = Math.max(0, Math.min(index, lessonData.length - 1)); const lesson = lessonData[activeIndex]; document.querySelector('[data-progress]').textContent = `${activeIndex + 1} / ${lessonData.length}`; document.querySelector('[data-lesson-eyebrow]').textContent = lesson.eyebrow; document.querySelector('[data-lesson-title]').textContent = lesson.title; document.querySelector('[data-lesson-summary]').textContent = lesson.summary; document.querySelector('[data-lesson-why]').textContent = lesson.why; document.querySelector('[data-lesson-without]').textContent = `Without this layer: ${lesson.without}`; document.querySelector('[data-lesson-role]').textContent = lesson.role; document.querySelector('[data-lesson-tradeoff]').textContent = lesson.tradeoff; document.querySelector('[data-lesson-question]').textContent = lesson.question; document.querySelector('[data-previous]').disabled = activeIndex === 0; document.querySelector('[data-next]').textContent = activeIndex === lessonData.length - 1 ? 'Start again ↺' : 'Next layer →'; document.querySelectorAll('.lesson-link').forEach((link) => link.classList.toggle('active', Number(link.dataset.index) === activeIndex)); nodes.replaceChildren(...lesson.nodes.map((node) => { const element = document.createElement('button'); element.type = 'button'; element.className = `lesson-node${lesson.highlight.includes(node.id) ? ' new-layer' : ''}`; element.dataset.nodeId = node.id; element.style.left = `${node.x}%`; element.style.top = `${node.y}%`; element.style.setProperty('--node-color', colors[node.kind] ?? '#176b58'); const source = components[node.id]; element.innerHTML = `<b>${node.label}</b><small>${node.detail}</small><em>${source?.layer ?? node.kind}</em>`; element.addEventListener('click', () => setSelected(node, lesson)); return element; })); drawEdges(lesson); const first = lesson.nodes.find((node) => lesson.highlight.includes(node.id)) ?? lesson.nodes[0]; setSelected(first, lesson); };
  const lessonList = document.querySelector('[data-lesson-list]'); lessonData.forEach((lesson, index) => { const link = document.createElement('button'); link.type = 'button'; link.className = 'lesson-link'; link.dataset.index = String(index); link.innerHTML = `<span>${String(index + 1).padStart(2, '0')}</span>${lesson.title}`; link.addEventListener('click', () => renderLesson(index)); lessonList.appendChild(link); });
  document.querySelector('[data-previous]').addEventListener('click', () => renderLesson(activeIndex === 0 ? 0 : activeIndex - 1)); document.querySelector('[data-next]').addEventListener('click', () => renderLesson(activeIndex === lessonData.length - 1 ? 0 : activeIndex + 1)); window.addEventListener('resize', () => drawEdges(lessonData[activeIndex])); renderLesson(0);
</script>
