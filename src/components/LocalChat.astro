---
interface CorpusEntry { id: string; title: string; kind: string; content: string; href: string; }
interface Props { corpus: CorpusEntry[]; }
const { corpus } = Astro.props;
---

<section class="local-chat" aria-label="Browser-local AI chatbot">
  <div class="chat-workspace">
    <header class="chat-topbar">
      <div class="chat-brand"><span class="brand-mark">✦</span><div><strong>Local AI</strong><small>Ansil’s portfolio assistant</small></div></div>
      <div class="runtime-pills" aria-label="Local model status">
        <span class="runtime-pill"><i data-ready-dot></i><b data-model-state>Not loaded</b></span>
        <span class="runtime-pill" data-backend>Checking browser</span>
        <span class="runtime-pill local-pill">Local only</span>
      </div>
      <details class="runtime-details">
        <summary>Runtime</summary>
        <div><span>Generation</span><b>Qwen 0.5B · q4</b></div>
        <div><span>Retrieval</span><b>MiniLM-L6-v2</b></div>
        <div><span>Execution</span><b data-runtime-execution>WebGPU / WASM</b></div>
        <div><span>Corpus</span><b>Curated public portfolio</b></div>
        <div><span>Demonstrates</span><b>Local inference · retrieval · fallback</b></div>
      </details>
      <button type="button" class="reset-button" data-reset>New chat</button>
    </header>

    <main class="chat-main">
      <div class="chat-messages" data-messages aria-live="polite">
        <section class="welcome-state" data-welcome>
          <div class="welcome-icon">✦</div>
          <h1>How can I help?</h1>
          <p>Ask about Ansil’s work, projects, or approach to applied AI. The response is generated locally in your browser.</p>
          <div class="model-start" data-model-start>
            <div><strong>Run a local chat model</strong><span>First visit downloads about 500 MB and caches it in your browser.</span></div>
            <button type="button" class="start-button" data-start>Start local chat</button>
          </div>
          <div class="download-panel" data-progress-wrap hidden>
            <div class="download-heading"><strong data-download-title>Downloading local model</strong><b data-progress-value>0%</b></div>
            <div class="download-track"><i data-progress-bar></i></div>
            <small data-download-note>Keep this tab open while the model is prepared.</small>
          </div>
          <div class="prompt-grid" aria-label="Suggested questions">
            <button type="button" data-prompt="Who is Ansil?"><span>About Ansil</span><b>Who is Ansil?</b></button>
            <button type="button" data-prompt="What kind of AI work has Ansil done?"><span>Experience</span><b>What kind of AI work has Ansil done?</b></button>
            <button type="button" data-prompt="Explain one of Ansil’s projects."><span>Projects</span><b>Explain one of Ansil’s projects.</b></button>
            <button type="button" data-prompt="How does this chatbot work?"><span>This demo</span><b>How does this chatbot work?</b></button>
            <button type="button" data-prompt="What would be relevant experience for a recruiter to know about Ansil?"><span>Recruiter</span><b>What should a recruiter know?</b></button>
            <button type="button" data-prompt="How does Ansil approach reliable AI systems?"><span>Technical</span><b>How does Ansil approach reliable AI?</b></button>
          </div>
        </section>
      </div>

      <div class="composer-area">
        <form class="chat-form" data-chat-form>
          <label class="sr-only" for="local-chat-input">Message the local assistant</label>
          <textarea id="local-chat-input" data-input rows="1" autocomplete="off" placeholder="Start the local model to begin…" disabled></textarea>
          <button class="send-button" type="submit" data-send aria-label="Send message" disabled>↑</button>
          <button class="stop-button" type="button" data-stop aria-label="Stop generation" hidden>■</button>
        </form>
        <div class="composer-meta"><span data-status>Preparing the local model…</span><span data-detail>WebGPU / WASM · private by design</span></div>
      </div>
    </main>

    <div class="generation-meta" data-generation-meta hidden><span data-retrieved>0 notes</span><span data-retrieval-method>semantic retrieval</span><span data-retrieval-time>retrieval —</span><span data-generation-time>generation —</span><span data-token-stats>tokens —</span></div>
  </div>
</section>

<style is:global>
  .local-chat { width:100%; min-height:min(760px,calc(100vh - 150px)); padding:12px 0 32px; }
  .chat-workspace { display:flex; flex-direction:column; min-height:min(720px,calc(100vh - 180px)); max-width:920px; margin:0 auto; overflow:hidden; border:1px solid var(--line); border-radius:18px; background:rgba(255,255,255,.42); box-shadow:0 18px 55px rgba(32,37,34,.07); }
  .chat-topbar { display:flex; align-items:center; gap:20px; padding:15px 20px; border-bottom:1px solid rgba(217,220,210,.8); background:rgba(248,247,242,.86); backdrop-filter:blur(12px); }
  .chat-brand { display:flex; align-items:center; gap:10px; min-width:190px; }
  .brand-mark { display:grid; place-items:center; width:29px; height:29px; border-radius:9px; background:var(--accent); color:var(--paper); font-size:15px; }
  .chat-brand strong,.chat-brand small { display:block; }.chat-brand strong { font-size:13px; }.chat-brand small { margin-top:1px; color:var(--muted); font-size:10px; }
  .runtime-pills { display:flex; align-items:center; gap:7px; flex:1; }.runtime-pill { display:flex; align-items:center; gap:6px; padding:6px 9px; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:10px; white-space:nowrap; }.runtime-pill b { color:var(--ink); font-weight:500; }.runtime-pill i { width:6px; height:6px; border-radius:50%; background:#c58745; }.runtime-pill i.ready { background:var(--accent); }.local-pill { border-color:#b5d2c4; color:var(--accent); background:#eef6f0; }
  .reset-button { padding:7px 10px; border:0; border-radius:7px; background:transparent; color:var(--muted); cursor:pointer; font-size:11px; }.reset-button:hover { background:var(--soft); color:var(--ink); }
  .runtime-details { position:relative; color:var(--muted); font-size:10px; }.runtime-details summary { padding:6px 9px; border:1px solid var(--line); border-radius:999px; cursor:pointer; list-style:none; }.runtime-details summary::-webkit-details-marker { display:none; }.runtime-details[open] summary { border-color:#a4c7ba; color:var(--accent); }.runtime-details>div { display:flex; justify-content:space-between; gap:20px; min-width:220px; padding:7px 0; border-bottom:1px solid var(--line); }.runtime-details>div:first-of-type { margin-top:8px; }.runtime-details b { color:var(--ink); font-weight:500; }
  .chat-main { display:flex; flex:1; flex-direction:column; min-height:0; }.chat-messages { flex:1; overflow:auto; padding:42px 64px 20px; }
  .welcome-state { display:flex; flex-direction:column; align-items:center; max-width:620px; margin:auto; text-align:center; }.welcome-icon { display:grid; place-items:center; width:46px; height:46px; margin-bottom:17px; border-radius:15px; background:#dfece4; color:var(--accent); font-size:22px; }.welcome-state h1 { font-size:clamp(31px,5vw,46px); letter-spacing:-.045em; }.welcome-state>p { max-width:490px; margin:12px auto 30px; color:#687068; font-size:15px; line-height:1.6; }
  .model-start { display:flex; align-items:center; justify-content:space-between; gap:15px; width:100%; margin:0 0 18px; padding:13px 15px; border:1px solid #b9d6c5; border-radius:12px; background:#eef6f0; text-align:left; }.model-start strong,.model-start span { display:block; }.model-start strong { color:var(--accent); font-size:12px; }.model-start span { margin-top:3px; color:#5d7165; font-size:10px; }.start-button { padding:9px 12px; border:0; border-radius:8px; background:var(--accent); color:var(--paper); cursor:pointer; font-size:11px; white-space:nowrap; }.start-button:disabled { opacity:.55; cursor:wait; }
  .download-panel { width:100%; margin:-7px 0 18px; padding:12px 14px; border:1px solid var(--line); border-radius:11px; background:#fff; text-align:left; }.download-heading { display:flex; justify-content:space-between; gap:15px; color:var(--accent); font-size:11px; }.download-heading b { font-weight:500; }.download-track { height:7px; margin:9px 0 6px; overflow:hidden; border-radius:99px; background:#e4e9e2; }.download-track i { display:block; width:0; height:100%; border-radius:99px; background:var(--accent); transition:width .25s; }.download-panel small { color:var(--muted); font-size:10px; }
  .prompt-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:9px; width:100%; text-align:left; }.prompt-grid button { min-height:78px; padding:13px 15px; border:1px solid var(--line); border-radius:11px; background:rgba(248,247,242,.72); color:var(--ink); cursor:pointer; text-align:left; transition:border-color .2s,background .2s,transform .2s; }.prompt-grid button:hover:not(:disabled) { border-color:#9ec5b2; background:#f2f8f3; transform:translateY(-1px); }.prompt-grid button:disabled { cursor:not-allowed; opacity:.48; }.prompt-grid span,.prompt-grid b { display:block; }.prompt-grid span { margin-bottom:7px; color:var(--accent); font-size:10px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }.prompt-grid b { font-size:12px; font-weight:500; line-height:1.35; }
  .chat-message { display:flex; max-width:730px; margin:0 auto 26px; }.chat-message.user { justify-content:flex-end; }.chat-message p { max-width:70%; margin:0; padding:12px 16px; border-radius:17px 17px 4px 17px; background:var(--accent); color:var(--paper); font-size:14px; line-height:1.55; white-space:pre-wrap; }.chat-message.assistant { position:relative; display:block; }.chat-message.assistant p { max-width:85%; padding:5px 0; border-radius:0; background:transparent; color:var(--ink); font-size:15px; line-height:1.7; }.chat-message.assistant code { padding:2px 5px; border-radius:4px; background:#e8eee8; font:13px monospace; }
  .message-actions,.followup-list { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }.message-action,.followup-button { padding:4px 7px; border:1px solid transparent; border-radius:6px; background:transparent; color:var(--muted); cursor:pointer; font-size:10px; }.message-action:hover,.followup-button:hover { border-color:var(--line); background:var(--soft); color:var(--ink); }
  .chat-source-details { max-width:85%; margin-top:10px; color:var(--muted); font-size:10px; }.chat-source-details summary { display:inline-block; cursor:pointer; }.chat-source-list { display:grid; gap:7px; margin-top:7px; }.chat-source-row { padding:8px 10px; border:1px solid var(--line); border-radius:8px; background:rgba(248,247,242,.65); }.chat-source-row a { display:block; color:var(--accent); font-size:11px; font-weight:700; }.chat-source-row small { display:block; margin-top:2px; color:var(--muted); font-size:9px; }.chat-source-row p { max-width:none!important; margin:5px 0 0!important; padding:0!important; color:#667068!important; font-size:11px!important; line-height:1.4!important; }
  .composer-area { padding:12px 64px 18px; background:linear-gradient(transparent,rgba(248,247,242,.95) 18%); }.chat-form { position:relative; max-width:730px; margin:0 auto; }.chat-form textarea { display:block; width:100%; min-height:51px; max-height:150px; padding:15px 54px 14px 17px; border:1px solid #cfd4ca; border-radius:16px; outline:none; background:#fff; color:var(--ink); box-shadow:0 4px 16px rgba(32,37,34,.06); font:14px Arial,sans-serif; line-height:1.45; resize:none; }.chat-form textarea:disabled { cursor:not-allowed; opacity:.68; }.chat-form textarea:focus { border-color:#8fbba5; box-shadow:0 0 0 3px rgba(23,107,88,.1); }.send-button,.stop-button { position:absolute; right:9px; bottom:9px; width:32px; height:32px; border:0; border-radius:10px; background:var(--accent); color:var(--paper); cursor:pointer; font-size:20px; line-height:1; }.stop-button { font-size:12px; background:#805d35; }.send-button:disabled { opacity:.45; cursor:wait; }.composer-meta { display:flex; justify-content:space-between; gap:15px; max-width:730px; margin:8px auto 0; color:var(--muted); font-size:10px; }.generation-meta { display:flex; flex-wrap:wrap; justify-content:center; gap:6px 15px; padding:7px; color:var(--muted); font-size:10px; }.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media(max-width:700px) { .local-chat { min-height:calc(100vh - 112px); padding:0 0 18px; }.chat-workspace { min-height:calc(100vh - 130px); border-right:0; border-left:0; border-radius:0; }.chat-topbar { padding:13px 16px; }.chat-brand { min-width:0; }.chat-brand small { display:none; }.runtime-pills { justify-content:flex-end; gap:4px; }.runtime-pill { padding:5px 7px; }.runtime-pill:not(:first-child) { font-size:0; }.local-pill,.runtime-details { display:none; }.reset-button { font-size:0; }.reset-button::after { content:'＋'; font-size:18px; }.chat-messages { padding:32px 18px 12px; }.welcome-state>p { font-size:14px; }.model-start { align-items:flex-start; flex-direction:column; }.start-button { width:100%; }.prompt-grid { grid-template-columns:1fr; }.prompt-grid button { min-height:64px; }.chat-message p { max-width:88%; }.chat-message.assistant p { max-width:96%; }.composer-area { padding:10px 16px 14px; }.composer-meta { font-size:9px; }.composer-meta span:last-child { display:none; }.generation-meta { justify-content:flex-start; padding-left:18px; padding-right:18px; } }
</style>

<script type="application/json" id="local-ai-corpus" set:html={JSON.stringify(corpus)}></script>

<script>
  import { env, pipeline, TextStreamer } from '@huggingface/transformers';

  const corpus = JSON.parse(document.querySelector('#local-ai-corpus')?.textContent ?? '[]');
  const root = document.querySelector('.local-chat');
  if (root) {
    const messages = root.querySelector('[data-messages]');
    const welcome = root.querySelector('[data-welcome]');
    const form = root.querySelector('[data-chat-form]');
    const input = root.querySelector('[data-input]');
    const send = root.querySelector('[data-send]');
    const stop = root.querySelector('[data-stop]');
    const status = root.querySelector('[data-status]');
    const modelState = root.querySelector('[data-model-state]');
    const readyDot = root.querySelector('[data-ready-dot]');
    const backendLabel = root.querySelector('[data-backend]');
    const detail = root.querySelector('[data-detail]');
    const retrieved = root.querySelector('[data-retrieved]');
    const retrievalMethod = root.querySelector('[data-retrieval-method]');
    const retrievalTime = root.querySelector('[data-retrieval-time]');
    const generationTime = root.querySelector('[data-generation-time]');
    const tokenStats = root.querySelector('[data-token-stats]');
    const runtimeExecution = root.querySelector('[data-runtime-execution]');
    const generationMeta = root.querySelector('[data-generation-meta]');
    const progressWrap = root.querySelector('[data-progress-wrap]');
    const progressBar = root.querySelector('[data-progress-bar]');
    const progressValue = root.querySelector('[data-progress-value]');
    const downloadTitle = root.querySelector('[data-download-title]');
    const downloadNote = root.querySelector('[data-download-note]');
    const startButton = root.querySelector('[data-start]');
    const history = [];
    let extractorPromise;
    let generatorPromise;
    let chunks;
    let isBusy = false;
    let modelReady = false;
    let fallbackMode = false;
    let generationController;
    let stopRequested = false;
    let lastRetrievalMethod = 'semantic retrieval';
    const MODEL = 'onnx-community/Qwen2.5-0.5B-Instruct-ONNX';
    const EMBEDDING_MODEL = 'Xenova/all-MiniLM-L6-v2';
    const stopwords = new Set(['the','and','for','that','this','with','from','when','what','where','which','into','does','your','have','will','are','was','were','been','then','than','only','not','but','can','how','about','tell','give','one']);
    const words = (value) => value.toLowerCase().replace(/[^a-z0-9\s]/g, ' ').split(/\s+/).filter((word) => word.length > 2 && !stopwords.has(word));
    const makeChunks = (entries) => entries.flatMap((entry) => { const tokens = entry.content.trim().split(/\s+/).filter(Boolean); const size = 110; const overlap = 18; const result = []; for (let start = 0; start < tokens.length; start += size - overlap) { const text = tokens.slice(start, start + size).join(' '); if (text) result.push({ id: entry.id, title: entry.title, kind: entry.kind, href: entry.href, text }); if (start + size >= tokens.length) break; } return result; });
    chunks = makeChunks(corpus);
    const setStatus = (value) => { if (status) status.textContent = value; };
    const setProgress = (value, label) => { if (!progressWrap) return; progressWrap.hidden = false; const percent = Math.max(0, Math.min(100, Math.round(value ?? 0))); if (progressValue) progressValue.textContent = `${percent}%`; if (progressBar) progressBar.style.width = `${percent}%`; if (label && downloadTitle) downloadTitle.textContent = label; };
    const scrollMessages = () => messages?.scrollTo({ top: messages.scrollHeight, behavior: 'smooth' });
    const escapeHtml = (value) => value.replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[character]));
    const renderMessage = (element, value) => { const safe = escapeHtml(value).replace(/`([^`]+)`/g, '<code>$1</code>').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\n/g, '<br>'); element.innerHTML = safe; };
    const addMessage = (role, text) => { welcome?.setAttribute('hidden', ''); const article = document.createElement('div'); article.className = `chat-message ${role}`; const copy = document.createElement('p'); if (role === 'assistant') renderMessage(copy, text); else copy.textContent = text; article.append(copy); messages?.append(article); scrollMessages(); return copy; };
    const addAssistantActions = (copy, question) => { const article = copy.closest('.chat-message'); if (!article || article.querySelector('.message-actions')) return; const actions = document.createElement('div'); actions.className = 'message-actions'; const copyButton = document.createElement('button'); copyButton.className = 'message-action'; copyButton.type = 'button'; copyButton.textContent = 'Copy'; copyButton.addEventListener('click', async () => { await navigator.clipboard?.writeText(copy.textContent ?? ''); copyButton.textContent = 'Copied'; setTimeout(() => { copyButton.textContent = 'Copy'; }, 1200); }); const regenerate = document.createElement('button'); regenerate.className = 'message-action'; regenerate.type = 'button'; regenerate.textContent = 'Regenerate'; regenerate.addEventListener('click', () => { article.remove(); answer(question, { regenerate: true }); }); actions.append(copyButton, regenerate); article.append(actions); };
    const addFollowups = (copy) => { const article = copy.closest('.chat-message'); if (!article || article.querySelector('.followup-list')) return; const list = document.createElement('div'); list.className = 'followup-list'; ['Tell me more about the technical approach', 'What project is most relevant?'].forEach((label) => { const button = document.createElement('button'); button.type = 'button'; button.className = 'followup-button'; button.textContent = label; button.addEventListener('click', () => answer(label)); list.append(button); }); article.append(list); };
    const addSources = (copy, evidence) => { const article = copy.closest('.chat-message'); if (!article || article.querySelector('.chat-source-details') || !evidence.length) return; const details = document.createElement('details'); details.className = 'chat-source-details'; const summary = document.createElement('summary'); summary.textContent = `Sources used · ${evidence.length}`; const list = document.createElement('div'); list.className = 'chat-source-list'; evidence.slice(0, 3).forEach((item) => { const row = document.createElement('div'); row.className = 'chat-source-row'; const link = document.createElement('a'); link.href = item.href; link.textContent = item.title; const meta = document.createElement('small'); meta.textContent = `${item.kind} · ${Math.round(item.score * 100)}% relevance`; const excerpt = document.createElement('p'); excerpt.textContent = `${item.text.slice(0, 180)}${item.text.length > 180 ? '…' : ''}`; row.append(link, meta, excerpt); list.append(row); }); details.append(summary, list); article.append(details); };
    const cosine = (left, right) => left.reduce((sum, value, index) => sum + value * right[index], 0);
    const keywordRetrieve = (question) => { const query = [...new Set(words(question))]; return chunks.map((chunk) => { const terms = new Set(words(chunk.text)); const matches = query.filter((term) => terms.has(term)); return { ...chunk, score: query.length ? matches.length / query.length : 0 }; }).sort((a, b) => b.score - a.score).slice(0, 4); };
    const retrieve = async (question) => { try { if (!extractorPromise) extractorPromise = pipeline('feature-extraction', EMBEDDING_MODEL, { progress_callback: (event) => { if (event.status === 'progress') setProgress(event.progress, 'Preparing retrieval model'); } }); const extractor = await extractorPromise; const query = Array.from((await extractor(question, { pooling: 'mean', normalize: true })).data); const ranked = await Promise.all(chunks.map(async (chunk) => ({ ...chunk, score: cosine(query, Array.from((await extractor(chunk.text, { pooling: 'mean', normalize: true })).data)) }))); lastRetrievalMethod = 'semantic retrieval'; return ranked.sort((a, b) => b.score - a.score).slice(0, 4); } catch (error) { extractorPromise = undefined; lastRetrievalMethod = 'keyword fallback'; console.warn('Semantic retrieval unavailable; using keyword fallback.', error); return keywordRetrieve(question); } };
    const getGenerator = async () => { if (!generatorPromise) { const device = 'gpu' in navigator ? 'webgpu' : 'wasm'; if (backendLabel) backendLabel.textContent = device === 'webgpu' ? 'WebGPU' : 'WASM'; if (runtimeExecution) runtimeExecution.textContent = device === 'webgpu' ? 'WebGPU' : 'WASM'; if (detail) detail.textContent = `${device === 'webgpu' ? 'WebGPU' : 'WASM'} · private by design`; env.backends.onnx.wasm.numThreads = Math.min(4, navigator.hardwareConcurrency || 1); generatorPromise = pipeline('text-generation', MODEL, { device, dtype: 'q4', progress_callback: (event) => { if (event.status === 'progress') setProgress(event.progress, 'Downloading local model'); } }); } return generatorPromise; };
    const buildPrompt = (question, evidence) => { const context = evidence.map((item, index) => `[SOURCE ${index + 1} · ${item.title} · ${item.kind}]\n${item.text}`).join('\n\n'); const previous = history.slice(-4).map((item) => `${item.role === 'user' ? 'Visitor' : 'Assistant'}: ${item.text}`).join('\n'); return `<|im_start|>system\nYou are a concise, conversational portfolio assistant for Ansil M B. Answer using the supplied public site context. Never invent personal facts, employers, projects, metrics, or experiences. If the context does not support a claim about Ansil, say: "I don't have enough information about Ansil to answer that." You may explain general AI concepts, and should say when an answer is general rather than profile-specific.\n\nPUBLIC SITE CONTEXT:\n${context}<|im_end|>\n${previous ? `${previous}\n` : ''}<|im_start|>user\n${question}<|im_end|>\n<|im_start|>assistant\n`; };
    const resizeInput = () => { if (!input) return; input.style.height = 'auto'; input.style.height = `${Math.min(input.scrollHeight, 150)}px`; };
    const fallbackAnswer = (question, evidence) => { const lower = question.toLowerCase(); if (lower.includes('who is ansil') || lower.includes('about ansil')) return 'Ansil M B builds applied AI systems for real business problems and explores the research underneath them. His work spans agentic systems, retrieval, computer vision, evaluation, and local AI experiments.'; if (evidence[0]) return `Here is the closest public note I found about Ansil’s work:\n\n${evidence[0].text.slice(0, 420)}${evidence[0].text.length > 420 ? '…' : ''}`; return "I don't have enough information about Ansil to answer that."; };
    const personalQuestion = (question) => /\b(ansil|his work|his experience|his project|portfolio|background|career|employer|built|worked)\b/i.test(question);
    const hasEvidence = (evidence) => evidence.length > 0 && evidence[0].score >= 0.22;
    const answer = async (question, options = {}) => { if (isBusy || !question.trim()) return; if (!modelReady && !fallbackMode) { setStatus('Click Start local chat to begin'); return; } isBusy = true; stopRequested = false; generationController = new AbortController(); if (send) send.disabled = true; if (stop) stop.hidden = false; if (options.regenerate) history.splice(-2); else addMessage('user', question.trim()); if (input) { input.value = ''; resizeInput(); } setStatus('Finding relevant notes…'); const retrievalStarted = performance.now(); const evidence = fallbackMode ? (lastRetrievalMethod = 'keyword fallback', keywordRetrieve(question)) : await retrieve(question); const retrievalMs = performance.now() - retrievalStarted; if (retrieved) retrieved.textContent = `${evidence.length} notes`; if (retrievalMethod) retrievalMethod.textContent = lastRetrievalMethod; if (retrievalTime) retrievalTime.textContent = `retrieval ${(retrievalMs / 1000).toFixed(1)}s`; if (generationMeta) generationMeta.hidden = false; const started = performance.now(); const copy = addMessage('assistant', 'Thinking…'); try { if (personalQuestion(question) && !hasEvidence(evidence)) { renderMessage(copy, "I don't have enough information about Ansil to answer that."); setStatus('Not enough grounded context'); } else if (fallbackMode) { renderMessage(copy, fallbackAnswer(question, evidence)); setStatus('Demo response · local model unavailable'); } else { const generator = await getGenerator(); const prompt = buildPrompt(question, evidence); let generated = ''; const streamer = new TextStreamer(generator.tokenizer, { skip_prompt: true, callback_function: (token) => { if (stopRequested) return; generated += token; renderMessage(copy, generated); scrollMessages(); } }); setStatus('Generating locally…'); const result = await generator(prompt, { max_new_tokens: 180, do_sample: true, temperature: 0.35, top_p: 0.9, return_full_text: false, streamer, signal: generationController.signal }); if (!generated) generated = String(result?.[0]?.generated_text ?? '').trim(); if (!stopRequested) renderMessage(copy, generated || "I don't have enough information about Ansil to answer that."); setStatus(stopRequested ? 'Generation stopped' : 'Ready'); } if (!stopRequested) { history.push({ role: 'user', text: question }, { role: 'assistant', text: copy.textContent }); addAssistantActions(copy, question); addSources(copy, evidence); addFollowups(copy); } const generationMs = performance.now() - started; const tokenCount = copy.textContent.split(/\s+/).filter(Boolean).length; if (generationTime) generationTime.textContent = `generation ${(generationMs / 1000).toFixed(1)}s`; if (tokenStats) tokenStats.textContent = `tokens ${tokenCount} · ${(tokenCount / Math.max(generationMs / 1000, .1)).toFixed(1)}/s`; } catch (error) { if (stopRequested || error?.name === 'AbortError') { setStatus('Generation stopped'); } else { console.error(error); fallbackMode = true; if (modelState) modelState.textContent = 'Demo fallback'; if (readyDot) readyDot.classList.add('ready'); renderMessage(copy, fallbackAnswer(question, evidence)); addAssistantActions(copy, question); addSources(copy, evidence); setStatus('Demo response · local model unavailable'); } } finally { isBusy = false; generationController = undefined; if (send) send.disabled = false; if (stop) stop.hidden = true; } };
    form?.addEventListener('submit', (event) => { event.preventDefault(); answer(input?.value ?? ''); });
    stop?.addEventListener('click', () => { stopRequested = true; generationController?.abort(); });
    input?.addEventListener('input', resizeInput);
    input?.addEventListener('keydown', (event) => { if (event.key === 'Enter' && !event.shiftKey) { event.preventDefault(); form?.requestSubmit(); } });
    const enableChat = () => { input?.removeAttribute('disabled'); if (send) send.disabled = false; };
    const classifyLoadError = (error) => { const message = String(error?.message ?? error).toLowerCase(); if (message.includes('fetch') || message.includes('network') || message.includes('download') || message.includes('404')) return 'The model download could not finish. Check your connection and retry.'; if (message.includes('webgpu') || message.includes('gpu')) return 'WebGPU could not initialize. The demo is available with a local fallback response mode.'; if (message.includes('memory') || message.includes('allocation')) return 'This device may not have enough memory for the local model. The demo is available with a local fallback response mode.'; return 'The local model could not initialize. The demo is available with a local fallback response mode.'; };
    const startLocalChat = async () => { if (modelReady || isBusy) return; if (!('WebAssembly' in window)) { fallbackMode = true; if (modelState) modelState.textContent = 'Demo fallback'; setStatus('WebAssembly is unavailable · fallback ready'); enableChat(); return; } isBusy = true; const started = performance.now(); if (startButton) { startButton.disabled = true; startButton.textContent = 'Loading…'; } if (modelState) modelState.textContent = 'Loading model'; setStatus('Downloading the local model…'); if (downloadTitle) downloadTitle.textContent = 'Downloading local model'; if (downloadNote) downloadNote.textContent = 'This can take a few minutes on the first visit. It will be cached afterward.'; if (progressWrap) progressWrap.hidden = false; try { await getGenerator(); modelReady = true; if (modelState) modelState.textContent = 'Model ready'; readyDot?.classList.add('ready'); if (progressValue) progressValue.textContent = '100%'; if (progressBar) progressBar.style.width = '100%'; if (downloadTitle) downloadTitle.textContent = 'Local model ready'; if (downloadNote) downloadNote.textContent = `Cached in this browser · loaded in ${((performance.now() - started) / 1000).toFixed(1)}s`; if (startButton) startButton.hidden = true; enableChat(); setStatus('Ready'); } catch (error) { console.error(error); generatorPromise = undefined; fallbackMode = true; if (modelState) modelState.textContent = 'Demo fallback'; if (downloadTitle) downloadTitle.textContent = 'Model unavailable'; if (downloadNote) downloadNote.textContent = classifyLoadError(error); if (startButton) { startButton.disabled = false; startButton.textContent = 'Retry local model'; } enableChat(); setStatus('Fallback ready · local model unavailable'); } finally { isBusy = false; } };
    startButton?.addEventListener('click', startLocalChat);
    root.querySelectorAll('[data-prompt]').forEach((button) => button.addEventListener('click', () => { const question = button.dataset.prompt ?? ''; if (modelReady || fallbackMode) answer(question); else if (input) { input.value = question; resizeInput(); input.focus(); setStatus('Start local chat to send this question'); } }));
    root.querySelector('[data-reset]')?.addEventListener('click', () => { history.length = 0; if (messages) messages.innerHTML = ''; messages?.append(welcome); welcome?.removeAttribute('hidden'); if (generationMeta) generationMeta.hidden = true; setStatus('Ready for a new conversation'); input?.focus(); });
    if ('gpu' in navigator) { if (backendLabel) backendLabel.textContent = 'WebGPU available'; } else if (backendLabel) backendLabel.textContent = 'WASM fallback';
  }
</script>
