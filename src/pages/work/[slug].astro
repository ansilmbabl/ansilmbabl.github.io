---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const projects = await getCollection('work');
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={project.data.title} description={project.data.description}><div class="page-wrap"><div class="case-header"><div><p class="eyebrow">{project.data.category} / Case study</p><h1>{project.data.title}</h1><p class="intro">{project.data.description}</p></div><div class="side"><strong>Technologies</strong>{project.data.technologies.join(' · ')}{project.data.confidential && <><br /><br /><strong>Disclosure</strong>Sanitized description of confidential work.</>}</div></div><div class="case-body"><aside>Project notes<br /><br />Outcome & process</aside><article class="case-content"><Content /></article></div></div></BaseLayout>
