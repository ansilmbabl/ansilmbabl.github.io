---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const career = (await getCollection('career')).filter((entry) => !entry.data.draft).sort((a, b) => a.data.order - b.data.order);
const education = (await getCollection('education')).filter((entry) => !entry.data.draft).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="About">
  <div class="page-wrap">
    <p class="eyebrow">About / Context</p><h1>Curious about the <em>whole system.</em></h1>
    <div class="about-grid">
      <div><p>I’m an AI/ML Engineer and Data Scientist based in Bengaluru. I build systems that connect models to data, APIs, tools, and people—not just isolated demos.</p><p>My work has moved across financial services, pharmaceutical research, market research, oil and gas, trading-card intelligence, and internal workflow automation.</p></div>
      <div><p>I enjoy the space where technical decisions meet user feedback: understanding the real problem, making the system dependable, and iterating until it becomes useful.</p><div class="link-list"><a href="/resume.pdf">Resume <span>↗</span></a><a href="https://linkedin.com/in/ansilmbabl/">LinkedIn <span>↗</span></a><a href="https://github.com/ansilmbabl">GitHub <span>↗</span></a><a href="mailto:ansiljbs@gmail.com">Email <span>↗</span></a></div></div>
    </div>
    <div class="rule"></div><p class="eyebrow">Career history</p>
    <div class="timeline">{career.map((role) => <div class="timeline-row"><time>{role.data.period}</time><div><h3>{role.data.title} · {role.data.organization}</h3><p>{role.body}</p>{role.data.location && <small>{role.data.location}</small>}</div></div>)}</div>
    <div class="rule"></div><p class="eyebrow">Education</p>
    <div class="timeline">{education.map((entry) => <div class="timeline-row"><time>{entry.data.period}</time><div><h3>{entry.data.qualification}</h3><p>{entry.data.institution}</p>{entry.data.detail && <small>{entry.data.detail}</small>}</div></div>)}</div>
  </div>
</BaseLayout>
