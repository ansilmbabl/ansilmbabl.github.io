---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const catchups = await getCollection('catchups'); return catchups.filter((item) => !item.data.draft).map((item) => ({ params: { slug: item.id }, props: { item } })); }
const { item } = Astro.props;
const { Content } = await render(item);
---
<BaseLayout title={item.data.title} description={item.data.description}><div class="page-wrap"><article class="article"><header class="article-header"><p class="eyebrow">AI catchup · {item.data.published.toLocaleDateString('en-IN', { year:'numeric', month:'long', day:'numeric' })}</p><h1>{item.data.title}</h1><p class="intro">{item.data.description}</p></header><div class="article-body"><Content /></div></article></div></BaseLayout>
