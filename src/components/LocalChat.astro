---
interface CorpusEntry { id: string; title: string; kind: string; content: string; href: string; }
interface Props { corpus: CorpusEntry[]; }
const { corpus } = Astro.props;
import localChatModels from '../data/localChatModels';
import localChatRetrievalModels from '../data/localChatRetrievalModels';
import systemPrompt from '../data/localChatSystemPrompt.md?raw';
---

<section class="local-chat" aria-label="Experimental browser-local AI assistant">
  <div class="chat-workspace">
    <header class="chat-topbar">
      <div class="chat-brand"><span class="brand-mark">✦</span><div><strong>AI assistant</strong></div></div>
      <div class="runtime-pills" aria-label="Local model status">
        <span class="runtime-pill"><i data-ready-dot></i><b data-model-state>Not loaded</b></span>
        <span class="runtime-pill" data-backend>Checking browser</span>
      </div>
      <details class="runtime-details">
        <summary>Runtime</summary>
        <div><span>Generation</span><b data-generation-model>Qwen 0.5B · q4</b></div>
        <div><span>Retrieval</span><b data-retrieval-model>MiniLM-L6-v2</b></div>
        <div><span>Execution</span><b data-runtime-execution>WebGPU / WASM</b></div>
        <div><span>Corpus</span><b>Curated public profile context</b></div>
        <div><span>Demonstrates</span><b>Local inference · retrieval · model behavior</b></div>
      </details>
      <button type="button" class="reset-button" data-reset>New chat</button>
    </header>

    <main class="chat-main">
      <div class="chat-messages" data-messages aria-live="polite">
        <section class="welcome-state" data-welcome>
          <h1>Experimental AI assistant</h1>
          <p>Chat with Hugging Face models in your browser. Ask general questions or explore the public profile context.</p>
          <div class="model-start" data-model-start>
            <div><strong>Choose a local chat model</strong><span data-model-note>First visit downloads about 500 MB and caches it in your browser. Smaller models may be less reliable.</span></div>
            <div class="model-controls">
              <label class="model-select-label" for="local-chat-model">Generation model<select id="local-chat-model" data-model-select>{localChatModels.map((model) => <option value={model.id}>{model.label} · {model.description}</option>)}</select></label>
              <label class="model-select-label" for="local-chat-retrieval-model">Retrieval model<select id="local-chat-retrieval-model" data-retrieval-select>{localChatRetrievalModels.map((model) => <option value={model.id}>{model.label} · {model.description}</option>)}</select></label>
              <button type="button" class="start-button" data-start>Start local chat</button>
              <button type="button" class="change-model-button" data-change-model hidden>Change model</button>
            </div>
          </div>
          <div class="download-panel" data-progress-wrap hidden>
            <div class="download-heading"><strong data-download-title>Downloading local model</strong><b data-progress-value>0%</b></div>
            <div class="download-track"><i data-progress-bar></i></div>
            <small data-download-stage>Preparing the browser runtime</small>
            <small data-download-note>Keep this tab open while the model is prepared.</small>
          </div>
          <button class="custom-sources-trigger" type="button" data-open-custom>＋ Add your own notes</button>
          <dialog class="custom-sources-dialog" data-custom-dialog aria-labelledby="custom-sources-title">
            <div class="custom-sources-body">
              <div class="custom-sources-heading"><div><span class="custom-sources-kicker">Local knowledge</span><h2 id="custom-sources-title">Add your own notes</h2></div><button class="custom-sources-close" type="button" data-close-custom aria-label="Close notes dialog">×</button></div>
              <p>Paste text or add Markdown/text files. They stay in this browser and are cleared when you remove them.</p>
              <label class="custom-input-label" for="local-custom-text">Paste notes<textarea id="local-custom-text" data-custom-text rows="6" placeholder="Paste notes you want the local RAG system to use…"></textarea></label>
              <label class="custom-file-label" for="local-custom-files">Or upload text files<input id="local-custom-files" data-custom-files type="file" accept=".txt,.md,text/plain,text/markdown" multiple /></label>
              <div class="custom-source-actions"><button type="button" data-add-custom>Add to local knowledge</button><button type="button" data-clear-custom>Clear custom data</button><span data-custom-status>No custom notes</span></div>
              <div class="custom-notes-list" data-custom-list hidden><strong>Added in this session</strong><div data-custom-items></div></div>
            </div>
          </dialog>
          <dialog class="source-preview-dialog" data-source-preview aria-labelledby="source-preview-title">
            <div class="source-preview-body">
              <div class="custom-sources-heading"><div><span class="custom-sources-kicker">Retrieved context</span><h2 id="source-preview-title" data-source-preview-title>Source preview</h2></div><button class="custom-sources-close" type="button" data-close-source-preview aria-label="Close source preview">×</button></div>
              <div class="source-preview-meta" data-source-preview-meta></div>
              <p class="source-preview-excerpt" data-source-preview-excerpt></p>
              <button class="source-preview-close" type="button" data-close-source-preview>Close preview</button>
            </div>
          </dialog>
          <button class="web-news-trigger" type="button" data-prompt="Search latest AI news"><span>Web search</span><b>Search latest AI news</b></button>
          <div class="prompt-grid" aria-label="Suggested questions">
            <button type="button" data-prompt="Who is Ansil?"><span>About Ansil</span><b>Who is Ansil?</b></button>
            <button type="button" data-prompt="What kind of AI work has Ansil done?"><span>Experience</span><b>What kind of AI work has Ansil done?</b></button>
            <button type="button" data-prompt="Explain one of Ansil’s projects."><span>Projects</span><b>Explain one of Ansil’s projects.</b></button>
            <button type="button" data-prompt="How does this chatbot work?"><span>This demo</span><b>How does this chatbot work?</b></button>
          </div>
        </section>
      </div>

      <div class="composer-area">
        <form class="chat-form" data-chat-form>
          <label class="sr-only" for="local-chat-input">Message the local assistant</label>
          <textarea id="local-chat-input" data-input rows="1" autocomplete="off" placeholder="Ask a general question or explore the profile context…" disabled></textarea>
          <button class="send-button" type="submit" data-send aria-label="Send message" disabled>↑</button>
          <button class="stop-button" type="button" data-stop aria-label="Stop generation" hidden>■</button>
        </form>
        <div class="composer-meta"><span data-status aria-live="polite">Choose a model and start local chat</span><span data-detail>Private by design · messages stay in this browser</span></div>
      </div>
    </main>

    <div class="generation-meta" data-generation-meta hidden aria-live="polite"><span data-retrieved>0 notes</span><span data-retrieval-method>semantic retrieval</span><span data-retrieval-time>retrieval —</span><span data-generation-time>generation —</span><span data-token-stats>tokens —</span></div>
  </div>
</section>

<style is:global>
  .local-chat { width:100%; min-height:min(760px,calc(100vh - 150px)); padding:12px 0 32px; }
  .chat-workspace { display:flex; flex-direction:column; min-height:min(720px,calc(100vh - 180px)); max-width:920px; margin:0 auto; overflow:hidden; border:1px solid var(--line); border-radius:18px; background:rgba(255,255,255,.42); box-shadow:0 18px 55px rgba(32,37,34,.07); }
  .chat-topbar { display:flex; align-items:center; gap:20px; padding:15px 20px; border-bottom:1px solid rgba(217,220,210,.8); background:rgba(248,247,242,.86); backdrop-filter:blur(12px); }
  .chat-brand { display:flex; align-items:center; gap:10px; min-width:190px; }
  .brand-mark { display:grid; place-items:center; width:29px; height:29px; border-radius:9px; background:var(--accent); color:var(--paper); font-size:15px; }
  .chat-brand strong,.chat-brand small { display:block; }.chat-brand strong { font-size:13px; }.chat-brand small { margin-top:1px; color:var(--muted); font-size:10px; }
  .runtime-pills { display:flex; align-items:center; gap:7px; flex:1; }.runtime-pill { display:flex; align-items:center; gap:6px; padding:6px 9px; border:1px solid var(--line); border-radius:999px; color:var(--muted); font-size:10px; white-space:nowrap; }.runtime-pill b { color:var(--ink); font-weight:500; }.runtime-pill i { width:6px; height:6px; border-radius:50%; background:#c58745; }.runtime-pill i.ready { background:var(--accent); }.local-pill { border-color:#b5d2c4; color:var(--accent); background:#eef6f0; }
  .reset-button { padding:7px 10px; border:0; border-radius:7px; background:transparent; color:var(--muted); cursor:pointer; font-size:11px; }.reset-button:hover { background:var(--soft); color:var(--ink); }
  .runtime-details { position:relative; color:var(--muted); font-size:10px; }.runtime-details summary { padding:6px 9px; border:1px solid var(--line); border-radius:999px; cursor:pointer; list-style:none; }.runtime-details summary::-webkit-details-marker { display:none; }.runtime-details[open] summary { border-color:#a4c7ba; color:var(--accent); }.runtime-details>div { display:flex; justify-content:space-between; gap:20px; min-width:220px; padding:7px 0; border-bottom:1px solid var(--line); }.runtime-details>div:first-of-type { margin-top:8px; }.runtime-details b { color:var(--ink); font-weight:500; }
  .chat-main { display:flex; flex:1; flex-direction:column; min-height:0; }.chat-messages { flex:1; overflow:auto; padding:42px 64px 20px; }
  .welcome-state { display:flex; flex-direction:column; align-items:center; max-width:650px; margin:auto; text-align:center; }.welcome-kicker { margin-bottom:13px; color:var(--accent); font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }.welcome-state h1 { max-width:600px; margin:0; font-size:clamp(30px,5vw,46px); letter-spacing:-.05em; line-height:1.05; }.welcome-state>p { max-width:510px; margin:16px auto 30px; color:#687068; font-size:15px; line-height:1.65; }
  .model-start { display:flex; flex-direction:column; gap:13px; width:100%; margin:0 0 18px; padding:13px 15px; border:1px solid #b9d6c5; border-radius:12px; background:#eef6f0; text-align:left; }.model-start>div:first-child strong,.model-start>div:first-child span { display:block; }.model-start strong { color:var(--accent); font-size:12px; }.model-start span { margin-top:3px; color:#5d7165; font-size:10px; }.model-controls { display:flex; align-items:end; gap:10px; width:100%; }.model-select-label { display:flex; flex:1; flex-direction:column; gap:4px; min-width:0; color:var(--muted); font-size:10px; }.model-select-label select { width:100%; max-width:none; padding:8px 28px 8px 9px; border:1px solid #b9d6c5; border-radius:8px; background:#fff; color:var(--ink); font:11px Arial,sans-serif; }.model-select-label select:disabled { opacity:.65; }.start-button { padding:9px 12px; border:0; border-radius:8px; background:var(--accent); color:var(--paper); cursor:pointer; font-size:11px; white-space:nowrap; }.start-button:disabled { opacity:.55; cursor:wait; }
  .model-select-label { display:flex; flex-direction:column; gap:4px; min-width:210px; color:var(--muted); font-size:10px; }.model-select-label select { max-width:270px; padding:8px 28px 8px 9px; border:1px solid #b9d6c5; border-radius:8px; background:#fff; color:var(--ink); font:11px Arial,sans-serif; }.model-select-label select:disabled { opacity:.65; }.change-model-button { padding:9px 12px; border:1px solid #a7c8b5; border-radius:8px; background:transparent; color:var(--accent); cursor:pointer; font-size:11px; white-space:nowrap; }.change-model-button:hover { background:#fff; }
  .download-panel { display:grid; gap:5px; width:100%; margin:-7px 0 18px; padding:12px 14px; border:1px solid var(--line); border-radius:11px; background:#fff; text-align:left; }.download-heading { display:flex; justify-content:space-between; gap:15px; color:var(--accent); font-size:11px; }.download-heading b { font-weight:500; }.download-track { height:7px; margin:5px 0 3px; overflow:hidden; border-radius:99px; background:#e4e9e2; }.download-track i { display:block; width:0; height:100%; border-radius:99px; background:var(--accent); transition:width .25s; }.download-panel small { color:var(--muted); font-size:10px; }.download-panel small[data-download-stage] { color:var(--ink); font-weight:600; }
  .custom-sources-trigger { display:inline-flex; align-items:center; gap:5px; align-self:flex-start; margin:-4px 0 18px; padding:7px 10px; border:1px solid var(--line); border-radius:999px; background:transparent; color:var(--accent); cursor:pointer; font-size:10px; }.custom-sources-trigger:hover { border-color:#9ec5b2; background:#f2f8f3; }.custom-sources-dialog { width:min(540px,calc(100% - 32px)); padding:0; border:0; border-radius:16px; background:transparent; box-shadow:0 22px 70px rgba(32,37,34,.2); }.custom-sources-dialog::backdrop { background:rgba(32,37,34,.28); backdrop-filter:blur(3px); }.custom-sources-body { display:grid; gap:13px; padding:22px; border:1px solid #b9d6c5; border-radius:16px; background:var(--paper); text-align:left; }.custom-sources-heading { display:flex; align-items:flex-start; justify-content:space-between; gap:15px; }.custom-sources-kicker { display:block; margin:0 0 5px; color:var(--accent); font-size:10px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; }.custom-sources-heading h2 { font-size:25px; }.custom-sources-close { width:30px; height:30px; border:1px solid var(--line); border-radius:50%; background:transparent; color:var(--muted); cursor:pointer; font-size:21px; line-height:1; }.custom-sources-close:hover { border-color:#9ec5b2; color:var(--ink); }.custom-sources-body>p { margin:0; color:var(--muted); font-size:12px; line-height:1.5; }.custom-input-label,.custom-file-label { display:grid; gap:6px; color:var(--ink); font-size:11px; font-weight:600; }.custom-sources-body textarea { width:100%; padding:11px; border:1px solid var(--line); border-radius:9px; background:#fff; color:var(--ink); font:13px Arial,sans-serif; line-height:1.5; resize:vertical; }.custom-sources-body textarea:focus { border-color:#8fbba5; outline:3px solid rgba(23,107,88,.1); }.custom-file-label input[type=file] { padding:9px; border:1px dashed #a7c8b5; border-radius:9px; background:#f2f8f3; color:var(--muted); font-size:11px; }.custom-source-actions { display:flex; align-items:center; flex-wrap:wrap; gap:7px; }.custom-source-actions button { padding:8px 10px; border:1px solid #a7c8b5; border-radius:7px; background:transparent; color:var(--accent); cursor:pointer; font-size:10px; }.custom-source-actions button:first-child { background:var(--accent); color:var(--paper); }.custom-source-actions span { color:var(--muted); font-size:10px; }
  .custom-notes-list { display:grid; gap:7px; padding-top:12px; border-top:1px solid var(--line); }.custom-notes-list>strong { color:var(--muted); font-size:10px; font-weight:600; }.custom-note-row { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:8px 10px; border:1px solid var(--line); border-radius:8px; background:#fff; }.custom-note-row div { min-width:0; }.custom-note-row b,.custom-note-row small { display:block; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }.custom-note-row b { color:var(--ink); font-size:11px; }.custom-note-row small { margin-top:2px; color:var(--muted); font-size:9px; }.custom-note-remove { flex:0 0 auto; padding:4px 7px; border:0; border-radius:5px; background:transparent; color:#98634d; cursor:pointer; font-size:10px; }.custom-note-remove:hover { background:#f6e9e3; }
  .source-preview-dialog { width:min(520px,calc(100% - 32px)); padding:0; border:0; border-radius:16px; background:transparent; box-shadow:0 22px 70px rgba(32,37,34,.2); }.source-preview-dialog::backdrop { background:rgba(32,37,34,.28); backdrop-filter:blur(3px); }.source-preview-body { display:grid; gap:13px; padding:22px; border:1px solid #b9d6c5; border-radius:16px; background:var(--paper); text-align:left; }.source-preview-meta { color:var(--accent); font-size:10px; font-weight:600; }.source-preview-excerpt { max-height:260px; margin:0; overflow:auto; padding:13px; border:1px solid var(--line); border-radius:10px; background:#fff; color:var(--ink); font-size:13px; line-height:1.65; white-space:pre-wrap; }.source-preview-close { justify-self:end; padding:8px 11px; border:1px solid #a7c8b5; border-radius:7px; background:var(--accent); color:var(--paper); cursor:pointer; font-size:10px; }
  .web-news-trigger { display:grid; gap:4px; align-self:flex-start; margin:-6px 0 18px; padding:9px 11px; border:1px solid #c9b98f; border-radius:10px; background:#fffaf0; color:#80652f; cursor:pointer; text-align:left; font-size:10px; }.web-news-trigger span,.web-news-trigger b { display:block; }.web-news-trigger span { font-size:9px; text-transform:uppercase; letter-spacing:.05em; }.web-news-trigger b { color:var(--ink); font-size:11px; font-weight:600; }.web-news-trigger:hover { border-color:#a58a50; background:#fff5dc; }
  .prompt-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:9px; width:100%; text-align:left; }.prompt-grid button { min-height:78px; padding:13px 15px; border:1px solid var(--line); border-radius:11px; background:rgba(248,247,242,.72); color:var(--ink); cursor:pointer; text-align:left; transition:border-color .2s,background .2s,transform .2s; }.prompt-grid button:hover:not(:disabled) { border-color:#9ec5b2; background:#f2f8f3; transform:translateY(-1px); }.prompt-grid button:disabled { cursor:not-allowed; opacity:.48; }.prompt-grid span,.prompt-grid b { display:block; }.prompt-grid span { margin-bottom:7px; color:var(--accent); font-size:10px; font-weight:700; letter-spacing:.04em; text-transform:uppercase; }.prompt-grid b { font-size:12px; font-weight:500; line-height:1.35; }
  .chat-message { display:flex; max-width:730px; margin:0 auto 26px; }.chat-message.user { justify-content:flex-end; }.chat-message p { max-width:70%; margin:0; padding:12px 16px; border-radius:17px 17px 4px 17px; background:#dcece2; color:var(--ink); font-size:14px; line-height:1.6; white-space:pre-wrap; }.chat-message.assistant { position:relative; display:block; padding-left:34px; }.chat-message.assistant::before { content:'✦'; position:absolute; top:5px; left:0; display:grid; place-items:center; width:23px; height:23px; border-radius:8px; background:#dfece4; color:var(--accent); font-size:12px; }.chat-message.assistant p { max-width:85%; padding:5px 0; border-radius:0; background:transparent; color:var(--ink); font-size:15px; line-height:1.7; }.chat-message.assistant code { padding:2px 5px; border-radius:4px; background:#e8eee8; font:13px monospace; }.chat-message.is-thinking p::after { content:'▋'; margin-left:3px; color:var(--accent); animation:chat-cursor .9s steps(2,end) infinite; } @keyframes chat-cursor { 50% { opacity:0; } }
  .message-actions { display:flex; flex-wrap:wrap; gap:6px; margin-top:8px; }.message-action { padding:4px 7px; border:1px solid transparent; border-radius:6px; background:transparent; color:var(--muted); cursor:pointer; font-size:10px; }.message-action:hover { border-color:var(--line); background:var(--soft); color:var(--ink); }
  .chat-source-details { max-width:85%; margin-top:14px; color:var(--muted); font-size:10px; }.chat-source-details summary { display:inline-flex; align-items:center; gap:5px; padding:5px 8px; border:1px solid var(--line); border-radius:999px; background:rgba(248,247,242,.72); cursor:pointer; list-style:none; }.chat-source-details summary::-webkit-details-marker { display:none; }.chat-source-details summary::before { content:'⌕'; color:var(--accent); font-size:12px; }.chat-source-details[open] summary { border-color:#a4c7ba; color:var(--accent); }.chat-source-list { display:flex; flex-wrap:wrap; gap:7px; margin-top:8px; }.chat-source-chip { display:inline-flex; align-items:center; gap:7px; max-width:100%; padding:7px 9px; border:1px solid #cbded1; border-radius:999px; background:#f2f8f3; color:var(--accent); }.chat-source-chip:not(a) { cursor:pointer; }.chat-source-chip:hover { border-color:#8ebca4; color:var(--accent); background:#e8f3eb; }.chat-source-chip strong { max-width:190px; overflow:hidden; font-size:10px; font-weight:600; text-overflow:ellipsis; white-space:nowrap; }.chat-source-chip small { color:#6f8175; font-size:9px; white-space:nowrap; }.chat-source-chip::after { content:'↗'; font-size:10px; }.chat-source-chip:not(a)::after { content:'⌕'; }
  .composer-area { padding:12px 64px 18px; background:linear-gradient(transparent,rgba(248,247,242,.95) 18%); }.chat-form { position:relative; max-width:730px; margin:0 auto; }.chat-form textarea { display:block; width:100%; min-height:56px; max-height:150px; padding:16px 58px 15px 18px; border:1px solid #cfd4ca; border-radius:18px; outline:none; background:#fff; color:var(--ink); box-shadow:0 5px 18px rgba(32,37,34,.08); font:15px Arial,sans-serif; line-height:1.5; resize:none; }.chat-form textarea:disabled { cursor:not-allowed; opacity:.68; }.chat-form textarea:focus { border-color:#8fbba5; box-shadow:0 0 0 3px rgba(23,107,88,.1),0 5px 18px rgba(32,37,34,.08); }.send-button,.stop-button { position:absolute; right:10px; bottom:10px; width:35px; height:35px; border:0; border-radius:11px; background:var(--accent); color:var(--paper); cursor:pointer; font-size:20px; line-height:1; }.stop-button { font-size:12px; background:#805d35; }.send-button:disabled { opacity:.45; cursor:wait; }.composer-meta { display:flex; justify-content:space-between; gap:15px; max-width:730px; margin:9px auto 0; color:var(--muted); font-size:10px; }.generation-meta { display:flex; flex-wrap:wrap; justify-content:center; gap:6px 15px; padding:8px; color:var(--muted); font-size:10px; }.sr-only { position:absolute; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0,0,0,0); white-space:nowrap; border:0; }
  @media(max-width:700px) { .local-chat { min-height:calc(100vh - 112px); padding:0 0 18px; }.chat-workspace { min-height:calc(100vh - 130px); border-right:0; border-left:0; border-radius:0; }.chat-topbar { padding:13px 16px; }.chat-brand { min-width:0; }.chat-brand small { display:none; }.runtime-pills { justify-content:flex-end; gap:4px; }.runtime-pill { padding:5px 7px; }.runtime-pill:not(:first-child) { font-size:0; }.local-pill,.runtime-details { display:none; }.reset-button { font-size:0; }.reset-button::after { content:'＋'; font-size:18px; }.chat-messages { padding:32px 18px 12px; }.welcome-state>p { font-size:14px; }.model-start { align-items:stretch; }.model-controls { align-items:stretch; flex-direction:column; }.model-select-label,.model-select-label select { width:100%; max-width:none; }.start-button,.change-model-button { width:100%; }.prompt-grid { grid-template-columns:1fr; }.prompt-grid button { min-height:64px; }.chat-message p { max-width:88%; }.chat-message.assistant { padding-left:30px; }.chat-message.assistant p { max-width:96%; }.composer-area { padding:10px 16px 14px; }.composer-meta { font-size:9px; }.composer-meta span:last-child { display:none; }.generation-meta { justify-content:flex-start; padding-left:18px; padding-right:18px; } }
</style>

<script type="application/json" id="local-ai-corpus" set:html={JSON.stringify(corpus)}></script>
