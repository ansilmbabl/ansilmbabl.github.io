---
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Ansil M B — AI/ML Engineer building production AI systems.' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="icon" href="data:," />
    <title>{title} · Ansil M B</title>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/" aria-label="Ansil M B home">AMB<span>•</span></a>
      <nav aria-label="Primary navigation">
        <a href="/work/">Work</a>
        <a href="/writing/">Writing</a>
        <a href="/about/">About</a>
        <a href="/now/">Now</a>
        <a class="nav-contact" href="mailto:ansiljbs@gmail.com">Contact ↗</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer"><span>© 2026 Ansil M B</span><span>AI/ML · Bengaluru</span><a href="/">Home ↑</a></footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Space+Grotesk:wght@400;500;600;700&display=swap');
  :root { --ink:#151817; --paper:#f5f2ea; --muted:#6e746d; --line:rgba(21,24,23,.16); --acid:#c9f56e; --olive:#758844; --serif:Georgia,'Times New Roman',serif; }
  * { box-sizing:border-box; } html { scroll-behavior:smooth; } body { margin:0; color:var(--ink); background:var(--paper); font-family:'Space Grotesk',Arial,sans-serif; line-height:1.55; } a { color:inherit; text-decoration:none; } .site-header,.site-footer,.page-wrap { width:min(1120px,calc(100% - 64px)); margin:0 auto; } .site-header { padding:27px 0; display:flex; justify-content:space-between; align-items:center; } .brand { font:500 14px 'DM Mono',monospace; letter-spacing:.08em; } .brand span { color:#91b54e; padding-left:6px; } nav { display:flex; align-items:center; gap:26px; font-size:13px; } nav a { opacity:.68; } nav a:hover { opacity:1; } nav .nav-contact { opacity:1; background:var(--ink); color:var(--paper); padding:9px 13px; border-radius:3px; } .page-wrap { padding:110px 0 130px; } .eyebrow { margin:0 0 18px; color:var(--muted); font:500 11px 'DM Mono',monospace; letter-spacing:.1em; text-transform:uppercase; } h1,h2,h3 { margin:0; letter-spacing:-.06em; line-height:1.02; } h1 { max-width:850px; font-size:clamp(52px,8vw,108px); } h2 { font-size:clamp(38px,5vw,66px); } h1 em,h2 em { color:var(--olive); font-family:var(--serif); font-weight:400; } .intro { max-width:600px; margin-top:30px; color:#535951; font-size:18px; } .rule { height:1px; background:var(--line); margin:70px 0; } .button { display:inline-block; margin-top:32px; padding:13px 17px; background:var(--ink); color:var(--paper); border-radius:3px; font-size:13px; font-weight:600; } .button:hover { background:#343a34; } .site-footer { display:flex; justify-content:space-between; padding:23px 0 30px; border-top:1px solid var(--line); color:var(--muted); font:10px 'DM Mono',monospace; text-transform:uppercase; } .site-footer a { color:var(--ink); }
  .grid { display:grid; grid-template-columns:repeat(2,1fr); gap:16px; margin-top:60px; } .card { display:flex; flex-direction:column; min-height:270px; padding:25px; background:#eae6db; } .card:hover { background:#e1e5cf; } .card-meta { display:flex; justify-content:space-between; color:var(--muted); font:10px 'DM Mono',monospace; text-transform:uppercase; } .card h3 { margin:53px 0 12px; font-size:30px; } .card p { color:#5b6259; font-size:14px; } .card-bottom { display:flex; justify-content:space-between; align-items:end; gap:15px; margin-top:auto; padding-top:17px; border-top:1px solid var(--line); } .tags { display:flex; flex-wrap:wrap; gap:6px; } .tag { padding:4px 7px; border:1px solid var(--line); color:var(--muted); font:10px 'DM Mono',monospace; }
  .timeline { margin-top:60px; border-top:1px solid var(--line); } .timeline-row { display:grid; grid-template-columns:160px 1fr; gap:30px; padding:26px 0; border-bottom:1px solid var(--line); } .timeline-row time { color:var(--muted); font:11px 'DM Mono',monospace; } .timeline-row h3 { font-size:24px; } .timeline-row p { max-width:650px; margin:8px 0 0; color:#5b6259; }
  .article-list { margin-top:55px; border-top:1px solid var(--line); } .article-row { display:grid; grid-template-columns:140px 1fr 120px; gap:25px; align-items:start; padding:28px 0; border-bottom:1px solid var(--line); } .article-row time,.article-row .reading { color:var(--muted); font:11px 'DM Mono',monospace; } .article-row h3 { font-size:27px; } .article-row p { margin:9px 0 0; color:#5b6259; font-size:14px; } .article-row .reading { text-align:right; }
  .article { max-width:780px; } .article-header { margin-bottom:55px; } .article-header h1 { font-size:clamp(46px,7vw,84px); } .article-header .intro { font-size:17px; } .article-body { font-family:Georgia,serif; font-size:19px; line-height:1.75; } .article-body h2 { margin:48px 0 17px; font-family:'Space Grotesk',Arial,sans-serif; font-size:31px; } .article-body p { margin:0 0 22px; } .article-body code { padding:2px 5px; background:#e7e4da; font-size:.85em; } .article-body pre { overflow:auto; padding:18px; background:#202421; color:var(--paper); font:14px 'DM Mono',monospace; }
  .case-header { display:grid; grid-template-columns:1fr 280px; gap:60px; align-items:end; } .case-header h1 { font-size:clamp(48px,7vw,92px); } .case-header .side { border-left:1px solid var(--line); padding-left:25px; color:var(--muted); font-size:14px; } .case-header .side strong { display:block; margin-bottom:8px; color:var(--ink); font:11px 'DM Mono',monospace; text-transform:uppercase; } .case-body { display:grid; grid-template-columns:190px 1fr; gap:60px; margin-top:85px; } .case-body aside { color:var(--muted); font:11px 'DM Mono',monospace; text-transform:uppercase; } .case-content { max-width:720px; font-family:Georgia,serif; font-size:19px; line-height:1.7; } .case-content h2 { margin:0 0 18px; font-family:'Space Grotesk',Arial,sans-serif; font-size:34px; } .case-content p { margin:0 0 34px; } .case-content .callout { margin:45px 0; padding:25px; background:var(--ink); color:var(--paper); font-family:'Space Grotesk',Arial,sans-serif; font-size:20px; line-height:1.35; }
  .about-grid { display:grid; grid-template-columns:1fr 1fr; gap:70px; margin-top:65px; } .about-grid p { color:#535951; font-size:18px; } .link-list { margin-top:40px; border-top:1px solid var(--line); } .link-list a { display:flex; justify-content:space-between; padding:15px 0; border-bottom:1px solid var(--line); font:13px 'DM Mono',monospace; } .link-list a:hover { color:var(--olive); }
  @media (max-width:760px) { .site-header,.site-footer,.page-wrap { width:calc(100% - 38px); } nav a:not(.nav-contact) { display:none; } .page-wrap { padding:75px 0 90px; } .grid,.about-grid,.case-header { grid-template-columns:1fr; } .article-row { grid-template-columns:1fr; gap:10px; } .article-row .reading { text-align:left; } .timeline-row { grid-template-columns:1fr; gap:8px; } .case-body { grid-template-columns:1fr; gap:28px; margin-top:60px; } .case-body aside { order:-1; } .site-footer { gap:12px; flex-wrap:wrap; } }
</style>
