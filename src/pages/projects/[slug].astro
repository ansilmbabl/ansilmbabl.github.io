---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() { const projects = await getCollection('projects'); return projects.filter((project) => !project.data.draft).map((project) => ({ params: { slug: project.id }, props: { project } })); }
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={project.data.title} description={project.data.description}><div class="page-wrap"><div class="case-header"><div><p class="eyebrow">{project.data.type} / {project.data.status}</p><h1>{project.data.title}</h1><p class="intro">{project.data.description}</p></div><div class="side"><strong>Started</strong>{project.data.started ?? 'Ongoing'}<br /><br /><strong>Tools</strong>{project.data.technologies.join(' · ')}</div></div><div class="case-body"><aside>Personal project<br /><br />What I’m learning</aside><article class="case-content"><Content /></article></div></div></BaseLayout>
