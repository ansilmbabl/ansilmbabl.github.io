    const cleanGenerated = (value) => value.replace(/<\|im_(end|start)\|>/g, '').replace(/\s+$/, '').trim();
    const answer = async (question, options = {}) => { if (isBusy || !question.trim()) return; if (!modelReady && !fallbackMode) { setStatus('Click Start local chat to begin'); return; } const cleanQuestion = question.trim(); const personal = profileQuestion(cleanQuestion) || (history.some((item) => item.role === 'user' && profileQuestion(item.text)) && /\b(he|his|that project|this project|his work)\b/i.test(cleanQuestion)); const grounded = personal || demoQuestion(cleanQuestion); isBusy = true; stopRequested = false; generationController = new AbortController(); if (send) send.disabled = true; if (stop) stop.hidden = false; if (options.regenerate) history.splice(-2); else addMessage('user', cleanQuestion); if (input) { input.value = ''; resizeInput(); } setStatus(grounded ? 'Finding relevant notes…' : 'Preparing a general answer…'); const retrievalStarted = performance.now(); const evidence = grounded ? (fallbackMode ? (lastRetrievalMethod = 'keyword fallback', keywordRetrieve(cleanQuestion)) : await retrieve(cleanQuestion)) : (lastRetrievalMethod = 'general chat', []); const retrievalMs = performance.now() - retrievalStarted; if (retrieved) retrieved.textContent = `${evidence.length} notes`; if (retrievalMethod) retrievalMethod.textContent = lastRetrievalMethod; if (retrievalTime) retrievalTime.textContent = grounded ? `retrieval ${(retrievalMs / 1000).toFixed(1)}s` : 'general chat'; if (generationMeta) generationMeta.hidden = false; const started = performance.now(); const copy = addMessage('assistant', 'Thinking…'); try { if (personal && !supportsProfileQuestion(cleanQuestion, evidence)) { renderMessage(copy, "I don't have enough information about Ansil to answer that."); setStatus('Not enough directly supported context'); } else if (fallbackMode) { renderMessage(copy, fallbackAnswer()); setStatus('Model unavailable · retry to continue'); } else { const generator = await getGenerator(); const prompt = buildPrompt(cleanQuestion, evidence, generator, grounded); l